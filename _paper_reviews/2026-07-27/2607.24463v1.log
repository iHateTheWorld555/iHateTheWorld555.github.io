 32-32l0-96c0-17.7-14.3-32-32-32l-96 0zM448 352c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 64-64 0c-17.7 0-32 14.3-32 32s14.3 32 32 32l96 0c17.7 0 32-14.3 32-32l0-96z\" />\n153\t      </svg>\n154\t    </a>\n155\t    <!--- colored theme toggle -->\n156\t    <button type=\"button\" class=\"header-button color-tog\" onclick=\"toggleColorScheme();\" title=\"Toggle dark/light mode\" aria-label=\"Toggle color scheme\">\n157\t      <span class=\"toggle-icon automatic-tog\" aria-hidden=\"true\">\n158\t        <svg role=\"presentation\" height=\"1.25rem\" viewBox=\"0 0 24 24\">\n159\t          <path\n160\t            d=\"m14.3 16-.7-2h-3.2l-.7 2H7.8L11 7h2l3.2 9h-1.9M20 8.69V4h-4.69L12 .69 8.69 4H4v4.69L.69 12 4 15.31V20h4.69L12 23.31 15.31 20H20v-4.69L23.31 12 20 8.69m-9.15 3.96h2.3L12 9l-1.15 3.65Z\">\n161\t          </path>\n162\t        </svg>\n163\t      </span>\n164\t      <span class=\"toggle-icon light-tog\" aria-hidden=\"true\">\n165\t        <svg role=\"presentation\" height=\"1.25rem\" viewBox=\"0 0 24 24\">\n166\t          <path\n167\t            d=\"M12 8a4 4 0 0 0-4 4 4 4 0 0 0 4 4 4 4 0 0 0 4-4 4 4 0 0 0-4-4m0 10a6 6 0 0 1-6-6 6 6 0 0 1 6-6 6 6 0 0 1 6 6 6 6 0 0 1-6 6m8-9.31V4h-4.69L12 .69 8.69 4H4v4.69L.69 12 4 15.31V20h4.69L12 23.31 15.31 20H20v-4.69L23.31 12 20 8.69Z\">\n168\t          </path>\n169\t        </svg>\n170\t      </span>\n171\t      <span class=\"toggle-icon dark-tog\" aria-hidden=\"true\">\n172\t        <svg role=\"presentation\" height=\"1.25rem\" viewBox=\"0 0 24 24\">\n173\t          <path\n174\t            d=\"M12 18c-.89 0-1.74-.2-2.5-.55C11.56 16.5 13 14.42 13 12c0-2.42-1.44-4.5-3.5-5.45C10.26 6.2 11.11 6 12 6a6 6 0 0 1 6 6 6 6 0 0 1-6 6m8-9.31V4h-4.69L12 .69 8.69 4H4v4.69L.69 12 4 15.31V20h4.69L12 23.31 15.31 20H20v-4.69L23.31 12 20 8.69Z\">\n175\t          </path>\n176\t        </svg>\n177\t      </span>\n178\t    </button>\n179\t  </nav>\n180\t</header><nav class=\"ltx_page_navbar\">\n181\t<nav class=\"ltx_TOC\">\n182\t<ol class=\"ltx_toclist\">\n183\t<li class=\"ltx_tocentry ltx_tocentry_abstract\"><a href=\"#abstract1\" title=\"In MIND THE MICROPHONE GAP: BENCHMARKING ARRAY UPSAMPLING STRATEGIES FOR LATENT ACOUSTIC MAPPING\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\">Abstract</span></a></li>\n184\t<li class=\"ltx_tocentry ltx_tocentry_section\"><a href=\"#S1\" title=\"In MIND THE MICROPHONE GAP: BENCHMARKING ARRAY UPSAMPLING STRATEGIES FOR LATENT ACOUSTIC MAPPING\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">1 </span>Introduction</span></a></li>\n185\t<li class=\"ltx_tocentry ltx_tocentry_section\"><a href=\"#S2\" title=\"In MIND THE MICROPHONE GAP: BENCHMARKING ARRAY UPSAMPLING STRATEGIES FOR LATENT ACOUSTIC MAPPING\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">2 </span>Approach</span></a></li>\n186\t<li class=\"ltx_tocentry ltx_tocentry_section\">\n187\t<a href=\"#S3\" title=\"In MIND THE MICROPHONE GAP: BENCHMARKING ARRAY UPSAMPLING STRATEGIES FOR LATENT ACOUSTIC MAPPING\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">3 </span>Methodology</span></a>\n188\t<ol class=\"ltx_toclist ltx_toclist_section\">\n189\t<li class=\"ltx_tocentry ltx_tocentry_subsection\"><a href=\"#S3.SS1\" title=\"In 3 Methodology ‣ MIND THE MICROPHONE GAP: BENCHMARKING ARRAY UPSAMPLING STRATEGIES FOR LATENT ACOUSTIC MAPPING\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">3.1 </span>Datasets</span></a></li>\n190\t<li class=\"ltx_tocentry ltx_tocentry_subsection\"><a href=\"#S3.SS2\" title=\"In 3 Methodology ‣ MIND THE MICROPHONE GAP: BENCHMARKING ARRAY UPSAMPLING STRATEGIES FOR LATENT ACOUSTIC MAPPING\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">3.2 </span>Training</span></a></li>\n191\t<li class=\"ltx_tocentry ltx_tocentry_subsection\"><a href=\"#S3.SS3\" title=\"In 3 Methodology ‣ MIND THE MICROPHONE GAP: BENCHMARKING ARRAY UPSAMPLING STRATEGIES FOR LATENT ACOUSTIC MAPPING\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">3.3 </span>Evaluation</span></a></li>\n192\t</ol>\n193\t</li>\n194\t<li class=\"ltx_tocentry ltx_tocentry_section\"><a href=\"#S4\" title=\"In MIND THE MICROPHONE GAP: BENCHMARKING ARRAY UPSAMPLING STRATEGIES FOR LATENT ACOUSTIC MAPPING\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">4 </span>Results</span></a></li>\n195\t<li class=\"ltx_tocentry ltx_tocentry_section\"><a href=\"#S5\" title=\"In MIND THE MICROPHONE GAP: BENCHMARKING ARRAY UPSAMPLING STRATEGIES FOR LATENT ACOUSTIC MAPPING\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">5 </span>Conclusions</span></a></li>\n196\t<li class=\"ltx_tocentry ltx_tocentry_section\"><a href=\"#S6\" title=\"In MIND THE MICROPHONE GAP: BENCHMARKING ARRAY UPSAMPLING STRATEGIES FOR LATENT ACOUSTIC MAPPING\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">6 </span>Acknowledgements</span></a></li>\n197\t<li class=\"ltx_tocentry ltx_tocentry_bibliography\"><a href=\"#bib\" title=\"In MIND THE MICROPHONE GAP: BENCHMARKING ARRAY UPSAMPLING STRATEGIES FOR LATENT ACOUSTIC MAPPING\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\">References</span></a></li>\n198\t</ol></nav>\n199\t</nav>\n200\t<div class=\"ltx_page_main\">\n201\t<div id=\"infobox\" class=\"infobox\">\n202\t  <a id=\"license-tr\" href=\"https://info.arxiv.org/help/license/index.html#licenses-available\">\n203\t    License: CC BY 4.0\n204\t  </a>\n205\t  <div id=\"watermark-tr\">\n206\tarXiv:2607.24463v1 [cs.SD] 27 Jul 2026</div>\n207\t</div><div class=\"ltx_page_content\">\n208\t<article class=\"ltx_document ltx_authors_1line\">\n209\t<h1 class=\"ltx_title ltx_title_document\">MIND THE MICROPHONE GAP: BENCHMARKING ARRAY UPSAMPLING\n210\t<br class=\"ltx_break\">STRATEGIES FOR LATENT ACOUSTIC MAPPING</h1>\n211\t\n212\t<div id=\"abstract1\" class=\"ltx_abstract\">\n213\t<h6 class=\"ltx_title ltx_title_abstract\">Abstract</h6>\n214\t<p class=\"ltx_p\">Latent Acoustic Mapping (LAM) is a self-supervised learning method that generates high-resolution spherical acoustic maps from multichannel recordings without labelled data, matching supervised baselines on direction-of-arrival benchmarks.\n215\tHowever, LAM degrades significantly with sparse 4-channel arrays, as the low-resolution cross-spectral matrix captures far less spatial information than the 32-channel inputs LAM was designed for.\n216\tWe benchmark a diverse set of upsampling architectures, spanning lightweight convolutional networks, iterative back-projection models, physics-informed networks, and generative adversarial approaches.\n217\tWe also study whether aligning these upsamplers with LAM by training them jointly or in different stages helps preserve the spatial structure that LAM depends on.\n218\tResults show that the original full-resolution LAM is the strongest, that separately trained lightweight models are the most competitive learned approaches, and that representation alignment between the upsampler and LAM matters more than model complexity.</p>\n219\t</div>\n220\t<div id=\"p1\" class=\"ltx_para\">\n221\t<p id=\"p1.1\" class=\"ltx_p\"><span id=\"p1.1.1\" class=\"ltx_text ltx_font_bold ltx_font_italic\">Index Terms<span id=\"p1.1.1.1\" class=\"ltx_text ltx_font_upright\">— </span></span>\n222\tdirection-of-arrival,\n223\tacoustic mapping,\n224\tacoustic super-resolution,\n225\tmicrophone array processing</p>\n226\t</div>\n227\t<section id=\"S1\" class=\"ltx_section\">\n228\t<h2 class=\"ltx_title ltx_title_section\">\n229\t<span class=\"ltx_tag ltx_tag_section\">1 </span>Introduction</h2>\n230\t\n231\t<div id=\"S1.p1\" class=\"ltx_para\">\n232\t<p id=\"S1.p1.1\" class=\"ltx_p\">The Latent Acoustic Mapping (LAM) model <cite class=\"ltx_cite ltx_citemacro_cite\">[<a href=\"#bib.bib1\" title=\"Latent acoustic mapping for direction of arrival estimation: A self-supervised approach\" class=\"ltx_ref\">18</a>]</cite> is self-supervised to generate high-resolution spherical acoustic maps (SAMs) directly from multichannel microphone recordings, without requiring labelled training data.\n233\tLAM encodes the cross-spectral matrix (CSM) <cite class=\"ltx_cite ltx_citemacro_cite\">[<a href=\"#bib.bib3\" title=\"Array signal processing: concepts &amp; techniques\" class=\"ltx_ref\">11</a>]</cite> of a microphone array via a learnable back-projection <cite class=\"ltx_cite ltx_citemacro_cite\">[<a href=\"#bib.bib4\" title=\"Signal processing tools for radio astronomy\" class=\"ltx_ref\">22</a>]</cite> that maps covariance structure onto a Fibonacci tessellation <cite class=\"ltx_cite ltx_citemacro_cite\">[<a href=\"#bib.bib5\" title=\"Analyzing the effect of equal-angle spatial discretization on sound event localization and detection\" class=\"ltx_ref\">14</a>]</cite>, producing an initial “dirty” image that is refined through four denoising convolutions <cite class=\"ltx_cite ltx_citemacro_cite\">[<a href=\"#bib.bib7\" title=\"Beyond a Gaussian denoiser: residual learning of deep CNN for image denoising\" class=\"ltx_ref\">23</a>, <a href=\"#bib.bib8\" title=\"Methods for image denoising using convolutional neural network: a review\" class=\"ltx_ref\">10</a>]</cite>.\n234\tThe decoder then reconstructs the CSM from the denoised SAM using the array’s steering matrix <cite class=\"ltx_cite ltx_citemacro_cite\">[<a href=\"#bib.bib9\" title=\"Two decades of array signal processing research: the parametric approach\" class=\"ltx_ref\">13</a>]</cite>, and the model is trained end-to-end.\n235\tWith only 16K parameters, LAM operates efficiently and in parallel across frequency bands, matching or exceeding supervised counterparts <cite class=\"ltx_cite ltx_citemacro_cite\">[<a href=\"#bib.bib11\" title=\"DeepWave: a recurrent neural-network for real-time acoustic imaging\" class=\"ltx_ref\">20</a>, <a href=\"#bib.bib2\" title=\"Robust DoA estimation from deep acoustic imaging\" class=\"ltx_ref\">17</a>]</cite>.</p>\n236\t</div>\n237\t<div id=\"S1.p2\" class=\"ltx_para\">\n238\t<p id=\"S1.p2.2\" class=\"ltx_p\">Three issues persist, however.\n239\tFirst, LAM is a high-resolution model (with optimal performance using a 32-channel array) and real-world SELD systems commonly use compact 4-channel tetrahedral arrays <cite class=\"ltx_cite ltx_citemacro_cite\">[<a href=\"#bib.bib13\" title=\"STARSS23: an audio-visual dataset of spatial recordings of real scenes with spatiotemporal annotations of sound events\" class=\"ltx_ref\">19</a>, <a href=\"#bib.bib14\" title=\"Localization, detection and tracking of multiple moving sound sources with a convolutional recurrent neural network\" class=\"ltx_ref\">1</a>]</cite> (due to cost and hardware constraints). The difference between the <math id=\"S1.p2.1.m1\" class=\"ltx_Math\" alttext=\"4\\times 4\" display=\"inline\" intent=\":literal\"><semantics><mrow><mn>4</mn><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mn>4</mn></mrow><annotation encoding=\"application/x-tex\">4\\times 4</annotation></semantics></math> and <math id=\"S1.p2.2.m2\" class=\"ltx_Math\" alttext=\"32\\times 32\" display=\"inline\" intent=\":literal\"><semantics><mrow><mn>32</mn><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><mn>32</mn></mrow><annotation encoding=\"application/x-tex\">32\\times 32</annotation></semantics></math> CSM matrices is dramatic, with the former capturing drastically less spatial information.\n240\tA solution is to upsample the low-resolution CSM to the 32-channel space <cite class=\"ltx_cite ltx_citemacro_cite\">[<a href=\"#bib.bib1\" title=\"Latent acoustic mapping for direction of arrival estimation: A self-supervised approach\" class=\"ltx_ref\">18</a>, <a href=\"#bib.bib2\" title=\"Robust DoA estimation from deep acoustic imaging\" class=\"ltx_ref\">17</a>]</cite>.\n241\tSecond, in light of the above it remains unclear which super-resolution architectures best preserve the spatial structure that LAM’ depends on <cite class=\"ltx_cite ltx_citemacro_cite\">[<a href=\"#bib.bib11\" title=\"DeepWave: a recurrent neural-network for real-time acoustic imaging\" class=\"ltx_ref\">20</a>, <a href=\"#bib.bib17\" title=\"Theoretical analysis of the DAMAS algorithm and efficient implementation of the covariance matrix fitting method for large-scale problems\" class=\"ltx_ref\">2</a>]</cite>.\n242\tThird, even given a capable upsampler, the training strategy (whether to train the upsampler in isolation, in alignment with LAM, or fully end-to-end) critically affects downstream localisation performance <cite class=\"ltx_cite ltx_citemacro_cite\">[<a href=\"#bib.bib2\" title=\"Robust DoA estimation from deep acoustic imaging\" class=\"ltx_ref\">17</a>]</cite>, since joint training risks distorting the physical meaning of the CSM and domain overfitting.</p>\n243\t</div>\n244\t<div id=\"S1.p3\" class=\"ltx_para\">\n245\t<p id=\"S1.p3.1\" class=\"ltx_p\">This paper addresses all three points through a benchmark revealing how architecture and training strategy affect preservation of spatial information and downstream localisation.</p>\n246\t</div>\n247\t</section>\n248\t<section id=\"S2\" class=\"ltx_section\">\n249\t<h2 class=\"ltx_title ltx_title_section\">\n250\t<span class=\"ltx_tag ltx_tag_section\">2 </span>Approach</h2>\n251\t\n252\t<div id=\"S2.p1\" class=\"ltx_para\">\n253\t<p id=\"S2.p1.4\" class=\"ltx_p\">An upsampler maps a CSM <math id=\"S2.p1.1.m1\" class=\"ltx_Math\" alttext=\"\\mathbf{C}_{\\text{low}}\\in\\mathbb{C}^{k\\times M_{\\text{low}}\\times M_{\\text{low}}}\" display=\"inline\" intent=\":literal\"><semantics><mrow><msub><mi>𝐂</mi><mtext>low</mtext></msub><mo>∈</mo><msup><mi>ℂ</mi><mrow><mi>k</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><msub><mi>M</mi><mtext>low</mtext></msub><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><msub><mi>M</mi><mtext>low</mtext></msub></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\mathbf{C}_{\\text{low}}\\in\\mathbb{C}^{k\\times M_{\\text{low}}\\times M_{\\text{low}}}</annotation></semantics></math>—with frequency band index <math id=\"S2.p1.2.m2\" class=\"ltx_Math\" alttext=\"k\" display=\"inline\" intent=\":literal\"><semantics><mi>k</mi><annotation encoding=\"application/x-tex\">k</annotation></semantics></math> and low-resolution microphone count <math id=\"S2.p1.3.m3\" class=\"ltx_Math\" alttext=\"M_{\\text{low}}\" display=\"inline\" intent=\":literal\"><semantics><msub><mi>M</mi><mtext>low</mtext></msub><annotation encoding=\"application/x-tex\">M_{\\text{low}}</annotation></semantics></math>—to a high-resolution target <math id=\"S2.p1.4.m4\" class=\"ltx_Math\" alttext=\"\\mathbf{C_{\\text{high}}}\\in\\mathbb{C}^{k\\times M_{\\text{high}}\\times M_{\\text{high}}}\" display=\"inline\" intent=\":literal\"><semantics><mrow><msub><mi>𝐂</mi><mtext>high</mtext></msub><mo>∈</mo><msup><mi>ℂ</mi><mrow><mi>k</mi><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><msub><mi>M</mi><mtext>high</mtext></msub><mo lspace=\"0.222em\" rspace=\"0.222em\">×</mo><msub><mi>M</mi><mtext>high</mtext></msub></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\mathbf{C_{\\text{high}}}\\in\\mathbb{C}^{k\\times M_{\\text{high}}\\times M_{\\text{high}}}</annotation></semantics></math>.\n254\tBecause the CSM is complex-valued, all encoders are adapted to operate on its real and imaginary parts independently, thus approximating the Hermitian structure.\n255\tWe therefore aim to determine which encoder best serves this role; the candidates are introduced below in chronological order based on their original publication, and are also summarised in\n256\t<a href=\"#S2.T1\" title=\"In 2 Approach ‣ MIND THE MICROPHONE GAP: BENCHMARKING ARRAY UPSAMPLING STRATEGIES FOR LATENT ACOUSTIC MAPPING\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_tag\">Table</span> <span class=\"ltx_text ltx_ref_tag\">1</span></a>.</p>\n257\t</div>\n258\t<figure id=\"S2.T1\" class=\"ltx_table\">\n259\t<div id=\"S2.T1.2\" class=\"ltx_inline-block ltx_transformed_outer\" style=\"width:506.5pt;height:107.5pt;vertical-align:-51.3pt;\"><span class=\"ltx_transformed_inner\" style=\"transform:translate(-5.0pt,1.1pt) scale(0.98063740944121,0.98063740944121) ;\">\n260\t<table id=\"S2.T1.2.1\" class=\"ltx_tabular ltx_guessed_headers ltx_align_middle\">\n261\t<thead class=\"ltx_thead\">\n262\t<tr id=\"S2.T1.2.1.1.1\" class=\"ltx_tr\">\n263\t<th id=\"S2.T1.2.1.1.1.1\" class=\"ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t\" style=\"padding:-0.5pt 2.0pt;\"><span id=\"S2.T1.2.1.1.1.1.1\" class=\"ltx_text ltx_font_bold\">Model</span></th>\n264\t<th id=\"S2.T1.2.1.1.1.2\" class=\"ltx_td ltx_align_justify ltx_th ltx_th_column ltx_border_t\" style=\"padding:-0.5pt 2.0pt;\">\n265\t<span id=\"S2.T1.2.1.1.1.2.1\" class=\"ltx_inline-block ltx_align_top\">\n266\t<span id=\"S2.T1.2.1.1.1.2.1.1\" class=\"ltx_p ltx_align_left\"><span id=\"S2.T1.2.1.1.1.2.1.1.1\" class=\"ltx_text ltx_font_bold\">Description</span></span>\n267\t</span>\n268\t</th>\n269\t<th id=\"S2.T1.2.1.1.1.3\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t\" style=\"padding:-0.5pt 2.0pt;\" colspan=\"3\"><span id=\"S2.T1.2.1.1.1.3.1\" class=\"ltx_text ltx_font_bold\">Parameters</span></th>\n270\t<th id=\"S2.T1.2.1.1.1.4\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t\" style=\"padding:-0.5pt 2.0pt;\"><span id=\"S2.T1.2.1.1.1.4.1\" class=\"ltx_text ltx_font_bold\">GFLOPs</span></th>\n271\t<th id=\"S2.T1.2.1.1.1.5\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t\" style=\"padding:-0.5pt 2.0pt;\"><span id=\"S2.T1.2.1.1.1.5.1\" class=\"ltx_text ltx_font_bold\">Latency</span></th>\n272\t<th id=\"S2.T1.2.1.1.1.6\" class=\"ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t\" style=\"padding:-0.5pt 2.0pt;\"><span id=\"S2.T1.2.1.1.1.6.1\" class=\"ltx_text ltx_font_bold\">Peak mem.</span></th>\n273\t</tr>\n274\t<tr id=\"S2.T1.2.1.2.2\" class=\"ltx_tr\" style=\"--ltx-bg-color:#F2F2F2;\">\n275\t<th id=\"S2.T1.2.1.2.2.1\" class=\"ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t\" style=\"padding:-0.5pt 2.0pt;\"><span id=\"S2.T1.2.1.2.2.1.1\" class=\"ltx_text\" style=\"--ltx-bg-color:#F2F2F2;\">LAM <cite class=\"ltx_cite ltx_citemacro_cite\">[<a href=\"#bib.bib1\" title=\"Latent acoustic mapping for direction of arrival estimation: A self-supervised approach\" class=\"ltx_ref\">18</a>]</cite></span></th>\n276\t<th id=\"S2.T1.2.1.2.2.2\" class=\"ltx_td ltx_align_justify ltx_th ltx_th_column ltx_border_t\" style=\"padding:-0.5pt 2.0pt;\">\n277\t<span id=\"S2.T1.2.1.2.2.2.1\" class=\"ltx_inline-block ltx_align_top\" style=\"--ltx-bg-color:#F2F2F2;\">\n278\t<span id=\"S2.T1.2.1.2.2.2.1.1\" class=\"ltx_p ltx_align_left\">Reference full-resolution model (no upsampler).</span>\n279\t</span>\n280\t</th>\n281\t<th id=\"S2.T1.2.1.2.2.3\" class=\"ltx_td ltx_th ltx_th_column ltx_border_t\" style=\"padding:-0.5pt 2.0pt;\"></th>\n282\t<th id=\"S2.T1.2.1.2.2.4\" class=\"ltx_td ltx_nopad_l ltx_align_right ltx_th ltx_th_column ltx_border_t\" style=\"padding:-0.5pt 2.0pt;\"><span id=\"S2.T1.2.1.2.2.4.1\" class=\"ltx_text\" style=\"--ltx-bg-color:#F2F2F2;\">0.146</span></th>\n283\t<th id=\"S2.T1.2.1.2.2.5\" class=\"ltx_td ltx_nopad_l ltx_align_left ltx_th ltx_th_column ltx_border_t\" style=\"padding:-0.5pt 2.0pt;\"><span id=\"S2.T1.2.1.2.2.5.1\" class=\"ltx_text\" style=\"--ltx-bg-color:#F2F2F2;\">M</span></th>\n284\t<th id=\"S2.T1.2.1.2.2.6\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t\" style=\"padding:-0.5pt 2.0pt;\"><span id=\"S2.T1.2.1.2.2.6.1\" class=\"ltx_text\" style=\"--ltx-bg-color:#F2F2F2;\">0.61</span></th>\n285\t<th id=\"S2.T1.2.1.2.2.7\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t\" style=\"padding:-0.