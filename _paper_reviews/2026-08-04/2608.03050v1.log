ode\", readingMode);\n35\t    }\n36\t    // Pre-apply spinout-banner dismissal here, before the banner paints, so it\n37\t    // never flashes in only to be hidden later by the deferred arxiv-header.js.\n38\t    // Key matches arxiv-header.js: \"arxiv-banner-dismissed:\" + data-banner-name.\n39\t    if (localStorage.getItem('arxiv-banner-dismissed:spinout-nonprofit')) {\n40\t      document.documentElement.setAttribute(\"data-banner-dismissed\", \"\");\n41\t    }\n42\t  }\n43\t  // Run as soon as JS starts, to minimize repainting\n44\t  initializeReadingPreferences();\n45\t</script>\n46\t<link rel=\"apple-touch-icon\" sizes=\"180x180\"\n47\t  href=\"/static/browse/0.3.4/images/icons/apple-touch-icon.png\">\n48\t<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\"\n49\t  href=\"/static/browse/0.3.4/images/icons/favicon-32x32.png\">\n50\t<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\"\n51\t  href=\"/static/browse/0.3.4/images/icons/favicon-16x16.png\">\n52\t<link rel=\"manifest\" href=\"/static/browse/0.3.4/images/icons/site.webmanifest\">\n53\t<link rel=\"mask-icon\" href=\"/static/browse/0.3.4/images/icons/safari-pinned-tab.svg\" color=\"#5bbad5\">\n54\t<link rel=\"stylesheet\" type=\"text/css\" media=\"screen\" href=\"https://use.typekit.net/utz6mli.css\"><link rel=\"stylesheet\" type=\"text/css\" media=\"screen\"\n55\t  href=\"/static/base/1.0.1/css/arxiv-header-footer.css?v=20260626\"><style>\n56\t  /* Banner pre-dismissal (set above before paint -> no flash-then-hide) and\n57\t     reading-mode chrome hiding. */\n58\t  html[data-banner-dismissed] .ds-announcement { display: none; }\n59\t  html[data-reading-mode=\"enabled\"] .ds-announcement,\n60\t  html[data-reading-mode=\"enabled\"] .ds-site-footer { display: none; }\n61\t  /* Keep the announcement text dark on the Open-Blue band in both colour themes\n62\t     (otherwise it inherits the paper's warm-wash text in dark mode and washes out). */\n63\t  .ds-announcement-text { color: var(--arxiv-ink, #1c1a17); }\n64\t</style>\n65\t<script defer src=\"/static/base/1.0.1/js/arxiv-header.js?v=20260626\"></script>\n66\t</head>\n67\t<body>\n68\t<dialog id=\"modal-form\" aria-labelledby=\"modal-title\" closedby=\"any\">\n69\t  <form id=\"modal-form-content\" method=\"dialog\" enctype=\"multipart/form-data\">\n70\t    <header class=\"modal-header\">\n71\t      <h5 id=\"modal-title\" class=\"modal-title\">Report GitHub Issue</h5>\n72\t      <button type=\"submit\" formnovalidate class=\"modal-close\" aria-label=\"Close\">×</button>\n73\t    </header>\n74\t\n75\t    <div class=\"modal-body\">\n76\t      <label for=\"form_title\">Title:</label>\n77\t      <input class=\"form-control\" id=\"form_title\" name=\"form_title\" required placeholder=\"Enter title\">\n78\t\n79\t      <p id=\"selectedTextModalDescription\" hidden>Content selection saved. Describe the issue below:</p>\n80\t\n81\t      <label for=\"description\">Description:</label>\n82\t      <textarea class=\"form-control\" id=\"description\" name=\"description\" required maxlength=\"500\"\n83\t        placeholder=\"500 characters maximum\"></textarea>\n84\t    </div>\n85\t\n86\t    <footer class=\"modal-footer\">\n87\t      <button type=\"submit\" value=\"internal-report\" class=\"sr-only modal-submit\">Submit without GitHub</button>\n88\t      <button type=\"submit\" value=\"github-report\" class=\"modal-submit\">Submit in GitHub</button>\n89\t    </footer>\n90\t  </form>\n91\t</dialog><div class=\"ds-announcement\" id=\"announcement-banner\" role=\"region\" aria-label=\"Announcement\"\n92\t    data-banner-name=\"spinout-nonprofit\">\n93\t    <img class=\"ds-announcement-glyph\" src=\"/static/base/1.0.1/images/icons/smileybones-small.svg\" alt=\"\" aria-hidden=\"true\">\n94\t    <span class=\"ds-announcement-text\">arXiv is now an independent nonprofit!</span>\n95\t    <a class=\"ds-announcement-link\" href=\"https://info.arxiv.org/about\">Learn more</a>\n96\t    <button type=\"button\" class=\"ds-announcement-close\" a