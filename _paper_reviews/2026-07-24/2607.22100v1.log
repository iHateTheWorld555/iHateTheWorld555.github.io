h</span></th>\n<th id=\"S4.T6.15.5.7.2.7\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\" colspan=\"2\"><span id=\"S4.T6.15.5.7.2.7.1\" class=\"ltx_text ltx_font_bold\">MEUSLI</span></th>\n<th id=\"S4.T6.15.5.7.2.8\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\" colspan=\"2\"><span id=\"S4.T6.15.5.7.2.8.1\" class=\"ltx_text ltx_font_bold\">Scratch</span></th>\n<th id=\"S4.T6.15.5.7.2.9\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\" colspan=\"2\"><span id=\"S4.T6.15.5.7.2.9.1\" class=\"ltx_text ltx_font_bold\">MEUSLI</span></th>\n</tr>\n<tr id=\"S4.T6.15.5.8.3\" class=\"ltx_tr\">\n<th id=\"S4.T6.15.5.8.3.1\" class=\"ltx_td ltx_th ltx_th_row\"></th>\n<th id=\"S4.T6.15.5.8.3.2\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.2.1\" class=\"ltx_text ltx_font_bold\">Mono</span></th>\n<th id=\"S4.T6.15.5.8.3.3\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.3.1\" class=\"ltx_text ltx_font_bold\">Multi</span></th>\n<th id=\"S4.T6.15.5.8.3.4\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.4.1\" class=\"ltx_text ltx_font_bold\">Mono</span></th>\n<th id=\"S4.T6.15.5.8.3.5\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.5.1\" class=\"ltx_text ltx_font_bold\">Multi</span></th>\n<th id=\"S4.T6.15.5.8.3.6\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.6.1\" class=\"ltx_text ltx_font_bold\">Mono</span></th>\n<th id=\"S4.T6.15.5.8.3.7\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.7.1\" class=\"ltx_text ltx_font_bold\">Multi</span></th>\n<th id=\"S4.T6.15.5.8.3.8\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.8.1\" class=\"ltx_text ltx_font_bold\">Mono</span></th>\n<th id=\"S4.T6.15.5.8.3.9\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.9.1\" class=\"ltx_text ltx_font_bold\">Multi</span></th>\n<th id=\"S4.T6.15.5.8.3.10\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.10.1\" class=\"ltx_text ltx_font_bold\">Mono</span></th>\n<th id=\"S4.T6.15.5.8.3.11\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.11.1\" class=\"ltx_text ltx_font_bold\">Multi</span></th>\n<th id=\"S4.T6.15.5.8.3.12\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.12.1\" class=\"ltx_text ltx_font_bold\">Mono</span></th>\n<th id=\"S4.T6.15.5.8.3.13\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.13.1\" class=\"ltx_text ltx_font_bold\">Multi</span></th>\n<th id=\"S4.T6.15.5.8.3.14\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.14.1\" class=\"ltx_text ltx_font_bold\">Mono</span></th>\n<th id=\"S4.T6.15.5.8.3.15\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.15.1\" class=\"ltx_text ltx_font_bold\">Multi</span></th>\n<th id=\"S4.T6.15.5.8.3.16\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.16.1\" class=\"ltx_text ltx_font_bold\">Mono</span></th>\n<th id=\"S4.T6.15.5.8.3.17\" class=\"ltx_td ltx_align_center ltx_th ltx_th_column\"><span id=\"S4.T6.15.5.8.3.17.1\" class=\"ltx_text ltx_font_bold\">Multi</span></th>\n</tr>\n</thead>\n<tbody class=\"ltx_tbody\">\n<tr id=\"S4.T6.15.5.9.1\" class=\"ltx_tr\">\n<th id=\"S4.T6.15.5.9.1.1\" class=\"ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t\">Italian</th>\n<td id=\"S4.T6.15.5.9.1.2\" class=\"ltx_td ltx_align_center ltx_border_t\">129.0</td>\n<td id=\"S4.T6.15.5.9.1.3\" class=\"ltx_td ltx_align_center ltx_border_t\">12.6</td>\n<td id=\"S4.T6.15.5.9.1.4\" class=\"ltx_td ltx_align_center ltx_border_t\">3.4</td>\n<td id=\"S4.T6.15.5.9.1.5\" class=\"ltx_td ltx_align_center ltx_border_t\">3.7</td>\n<td id=\"S4.T6.15.5.9.1.6\" class=\"ltx_td ltx_align_center ltx_border_t\">0.8</td>\n<td id=\"S4.