 32s32-14.3 32-32l0-96c0-17.7-14.3-32-32-32l-96 0zM448 352c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 64-64 0c-17.7 0-32 14.3-32 32s14.3 32 32 32l96 0c17.7 0 32-14.3 32-32l0-96z\" />\n153\t      </svg>\n154\t    </a>\n155\t    <!--- colored theme toggle -->\n156\t    <button type=\"button\" class=\"header-button color-tog\" onclick=\"toggleColorScheme();\" title=\"Toggle dark/light mode\" aria-label=\"Toggle color scheme\">\n157\t      <span class=\"toggle-icon automatic-tog\" aria-hidden=\"true\">\n158\t        <svg role=\"presentation\" height=\"1.25rem\" viewBox=\"0 0 24 24\">\n159\t          <path\n160\t            d=\"m14.3 16-.7-2h-3.2l-.7 2H7.8L11 7h2l3.2 9h-1.9M20 8.69V4h-4.69L12 .69 8.69 4H4v4.69L.69 12 4 15.31V20h4.69L12 23.31 15.31 20H20v-4.69L23.31 12 20 8.69m-9.15 3.96h2.3L12 9l-1.15 3.65Z\">\n161\t          </path>\n162\t        </svg>\n163\t      </span>\n164\t      <span class=\"toggle-icon light-tog\" aria-hidden=\"true\">\n165\t        <svg role=\"presentation\" height=\"1.25rem\" viewBox=\"0 0 24 24\">\n166\t          <path\n167\t            d=\"M12 8a4 4 0 0 0-4 4 4 4 0 0 0 4 4 4 4 0 0 0 4-4 4 4 0 0 0-4-4m0 10a6 6 0 0 1-6-6 6 6 0 0 1 6-6 6 6 0 0 1 6 6 6 6 0 0 1-6 6m8-9.31V4h-4.69L12 .69 8.69 4H4v4.69L.69 12 4 15.31V20h4.69L12 23.31 15.31 20H20v-4.69L23.31 12 20 8.69Z\">\n168\t          </path>\n169\t        </svg>\n170\t      </span>\n171\t      <span class=\"toggle-icon dark-tog\" aria-hidden=\"true\">\n172\t        <svg role=\"presentation\" height=\"1.25rem\" viewBox=\"0 0 24 24\">\n173\t          <path\n174\t            d=\"M12 18c-.89 0-1.74-.2-2.5-.55C11.56 16.5 13 14.42 13 12c0-2.42-1.44-4.5-3.5-5.45C10.26 6.2 11.11 6 12 6a6 6 0 0 1 6 6 6 6 0 0 1-6 6m8-9.31V4h-4.69L12 .69 8.69 4H4v4.69L.69 12 4 15.31V20h4.69L12 23.31 15.31 20H20v-4.69L23.31 12 20 8.69Z\">\n175\t          </path>\n176\t        </svg>\n177\t      </span>\n178\t    </button>\n179\t  </nav>\n180\t</header><nav class=\"ltx_page_navbar\">\n181\t<nav class=\"ltx_TOC\">\n182\t<ol class=\"ltx_toclist\">\n183\t<li class=\"ltx_tocentry ltx_tocentry_abstract\"><a href=\"#abstract1\" title=\"In A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\">Abstract</span></a></li>\n184\t<li class=\"ltx_tocentry ltx_tocentry_section\"><a href=\"#S1\" title=\"In A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">1 </span>Introduction</span></a></li>\n185\t<li class=\"ltx_tocentry ltx_tocentry_section\"><a href=\"#S2\" title=\"In A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">2 </span>Signal Model</span></a></li>\n186\t<li class=\"ltx_tocentry ltx_tocentry_section\">\n187\t<a href=\"#S3\" title=\"In A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">3 </span>Online Mask-Based Covariance Estimation</span></a>\n188\t<ol class=\"ltx_toclist ltx_toclist_section\">\n189\t<li class=\"ltx_tocentry ltx_tocentry_subsection\"><a href=\"#S3.SS1\" title=\"In 3 Online Mask-Based Covariance Estimation ‣ A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">3.1 </span>Covariance Matrix Estimation</span></a></li>\n190\t<li class=\"ltx_tocentry ltx_tocentry_subsection\"><a href=\"#S3.SS2\" title=\"In 3 Online Mask-Based Covariance Estimation ‣ A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">3.2 </span>Mask Selection</span></a></li>\n191\t</ol>\n192\t</li>\n193\t<li class=\"ltx_tocentry ltx_tocentry_section\">\n194\t<a href=\"#S4\" title=\"In A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">4 </span>Evaluation</span></a>\n195\t<ol class=\"ltx_toclist ltx_toclist_section\">\n196\t<li class=\"ltx_tocentry ltx_tocentry_subsection\"><a href=\"#S4.SS1\" title=\"In 4 Evaluation ‣ A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">4.1 </span>Acoustic Scene and Data Generation</span></a></li>\n197\t<li class=\"ltx_tocentry ltx_tocentry_subsection\"><a href=\"#S4.SS2\" title=\"In 4 Evaluation ‣ A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">4.2 </span>Implementation and Algorithmic Settings</span></a></li>\n198\t<li class=\"ltx_tocentry ltx_tocentry_subsection\">\n199\t<a href=\"#S4.SS3\" title=\"In 4 Evaluation ‣ A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">4.3 </span>Results</span></a>\n200\t<ol class=\"ltx_toclist ltx_toclist_subsection\">\n201\t<li class=\"ltx_tocentry ltx_tocentry_subsubsection\"><a href=\"#S4.SS3.SSS1\" title=\"In 4.3 Results ‣ 4 Evaluation ‣ A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">4.3.1 </span>Temporal Contexts</span></a></li>\n202\t<li class=\"ltx_tocentry ltx_tocentry_subsubsection\"><a href=\"#S4.SS3.SSS2\" title=\"In 4.3 Results ‣ 4 Evaluation ‣ A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">4.3.2 </span>Microphone Configurations</span></a></li>\n203\t<li class=\"ltx_tocentry ltx_tocentry_subsubsection\"><a href=\"#S4.SS3.SSS3\" title=\"In 4.3 Results ‣ 4 Evaluation ‣ A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">4.3.3 </span>Influence of Input SNR</span></a></li>\n204\t</ol>\n205\t</li>\n206\t</ol>\n207\t</li>\n208\t<li class=\"ltx_tocentry ltx_tocentry_section\"><a href=\"#S5\" title=\"In A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\"><span class=\"ltx_tag ltx_tag_ref\">5 </span>Conclusions</span></a></li>\n209\t<li class=\"ltx_tocentry ltx_tocentry_bibliography\"><a href=\"#bib\" title=\"In A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\"><span class=\"ltx_text ltx_ref_title\">References</span></a></li>\n210\t</ol></nav>\n211\t</nav>\n212\t<div class=\"ltx_page_main\">\n213\t<div id=\"infobox\" class=\"infobox\">\n214\t  <a id=\"license-tr\" href=\"https://info.arxiv.org/help/license/index.html#licenses-available\">\n215\t    License: arXiv.org perpetual non-exclusive license\n216\t  </a>\n217\t  <div id=\"watermark-tr\">\n218\tarXiv:2607.26623v1 [eess.AS] 29 Jul 2026</div>\n219\t</div><div class=\"ltx_page_content\">\n220\t<article class=\"ltx_document ltx_authors_1line\">\n221\t<h1 class=\"ltx_title ltx_title_document\" style=\"font-size:90%;\">A Study on Online Mask-based Beamforming Using Per-channel\n222\t<br class=\"ltx_break\">Masking for Spatially Distributed Microphones</h1>\n223\t\n224\t<div id=\"abstract1\" class=\"ltx_abstract\">\n225\t<h6 class=\"ltx_title ltx_title_abstract\">Abstract</h6>\n226\t<p class=\"ltx_p\"><span class=\"ltx_text\" style=\"font-size:90%;\">Mask-based beamforming is a popular geometry-agnostic approach for speech enhancement, typically applying a single mask across all microphones to estimate the required covariance matrices.\n227\tWhile effective for compact arrays, this strategy may be suboptimal for spatially distributed microphones, where signal characteristics may vary strongly across microphones.\n228\tTo effectively capture the spatial diversity across microphones, we extend the mask-based beamformer to a multi-channel formulation, where each microphone is pre-filtered by a separate mask before covariance estimation.\n229\tTo address time-varying acoustic scenes, caused by spectro-temporal nonstationarity, we adopt a frame-causal online implementation with a sliding window.\n230\tExperiments with simulated compact arrays and distributed microphones show that multi-channel masking yields a benefit over using a single mask when microphone signals differ substantially, while retaining similar performance in compact arrays. We further demonstrate the robustness of the multi-channel masking approach by comparing oracle ideal ratio masks to blind DNN-based mask estimation.</span></p>\n231\t</div>\n232\t<div id=\"p1\" class=\"ltx_para\">\n233\t<p id=\"p1.1\" class=\"ltx_p\"><span id=\"p1.1.1\" class=\"ltx_text ltx_font_bold ltx_font_italic\" style=\"font-size:90%;\">Index Terms<span id=\"p1.1.1.1\" class=\"ltx_text ltx_font_upright\">— <span id=\"p1.1.1.1.1\" class=\"ltx_text ltx_font_medium\">\n234\tMask-based beamforming, multi-channel masking, distributed microphones</span></span></span></p>\n235\t</div>\n236\t<section id=\"S1\" class=\"ltx_section\">\n237\t<h2 class=\"ltx_title ltx_title_section\" style=\"font-size:90%;\">\n238\t<span class=\"ltx_tag ltx_tag_section\">1 </span>Introduction</h2>\n239\t\n240\t<div id=\"S1.p1\" class=\"ltx_para\">\n241\t<p id=\"S1.p1.1\" class=\"ltx_p\"><span id=\"S1.p1.1.1\" class=\"ltx_text\" style=\"font-size:90%;\">In many speech communication tasks, noise reduction is a essential to allow for seamless inter-human and human-machine interaction.\n242\tIf multiple microphones are available, spatial or directional information can be exploited besides spectro-temporal information </span><cite class=\"ltx_cite ltx_citemacro_cite\"><span id=\"S1.p1.1.2.1\" class=\"ltx_text\" style=\"font-size:90%;\">[</span><a href=\"#bib.bib57\" title=\"Multichannel signal enhancement algorithms for assisted listening devices: Exploiting spatial diversity using multiple microphones\" class=\"ltx_ref\">5</a>, <a href=\"#bib.bib18\" title=\"A consolidated perspective on multi-microphone speech enhancement and source separation\" class=\"ltx_ref\">8</a><span id=\"S1.p1.1.3.2\" class=\"ltx_text\" style=\"font-size:90%;\">]</span></cite><span id=\"S1.p1.1.4\" class=\"ltx_text\" style=\"font-size:90%;\">.\n243\tIn recent years, the interest in mask-based beamformers has increased </span><cite class=\"ltx_cite ltx_citemacro_cite\"><span id=\"S1.p1.1.5.1\" class=\"ltx_text\" style=\"font-size:90%;\">[</span><a href=\"#bib.bib136\" title=\"Improved MVDR beamforming using single-channel mask prediction networks\" class=\"ltx_ref\">6</a>, <a href=\"#bib.bib150\" title=\"On time-frequency mask estimation for MVDR beamforming with application in robust speech recognition\" class=\"ltx_ref\">27</a>, <a href=\"#bib.bib153\" title=\"Microphone array signal processing and deep learning for speech enhancement: combining model-based and data-driven approaches to parameter estimation and filtering\" class=\"ltx_ref\">10</a><span id=\"S1.p1.1.6.2\" class=\"ltx_text\" style=\"font-size:90%;\">]</span></cite><span id=\"S1.p1.1.7\" class=\"ltx_text\" style=\"font-size:90%;\">, particularly for deep neural network (DNN)-based geometry-agnostic processing, where the number and position of microphones are unknown. In such a system, a mask is estimated – for example with a DNN – and applied to all microphone signals to roughly isolate the speech and noise components in each microphone. This can be interpreted as a per-channel pre-filtering. The pre-filtered signals are used\n244\tto estimate the spatial parameters for a signal-dependent beamformer, often a minimum-variance distortionless response (MVDR) beamformer, generating the enhanced output signal </span><cite class=\"ltx_cite ltx_citemacro_cite\"><span id=\"S1.p1.1.8.1\" class=\"ltx_text\" style=\"font-size:90%;\">[</span><a href=\"#bib.bib144\" title=\"Deep ad-hoc beamforming\" class=\"ltx_ref\">28</a>, <a href=\"#bib.bib143\" title=\"Flexible multichannel speech enhancement for noise-robust frontend\" class=\"ltx_ref\">12</a>, <a href=\"#bib.bib134\" title=\"Array geometry-robust attention-based neural beamformer for moving speakers\" class=\"ltx_ref\">24</a>, <a href=\"#bib.bib151\" title=\"The CHiME-8 DASR challenge for generalizable and array agnostic distant automatic speech recognition and diarization\" class=\"ltx_ref\">3</a>, <a href=\"#bib.bib152\" title=\"Microphone array geometry-independent multi-talker distant ASR: NTT system for DASR task of the CHiME-8 challenge\" class=\"ltx_ref\">13</a><span id=\"S1.p1.1.9.2\" class=\"ltx_text\" style=\"font-size:90%;\">]</span></cite><span id=\"S1.p1.1.10\" class=\"ltx_text\" style=\"font-size:90%;\">.\n245\tThis is particularly valuable for distributed or ad-hoc microphone arrays, which often have unknown or variable geometries </span><cite class=\"ltx_cite ltx_citemacro_cite\"><span id=\"S1.p1.1.11.1\" class=\"ltx_text\" style=\"font-size:90%;\">[</span><a href=\"#bib.bib144\" title=\"Deep ad-hoc beamforming\" class=\"ltx_ref\">28</a>, <a href=\"#bib.bib143\" title=\"Flexible multichannel speech enhancement for noise-robust frontend\" class=\"ltx_ref\">12</a><span id=\"S1.p1.1.12.2\" class=\"ltx_text\" style=\"font-size:90%;\">]</span></cite><span id=\"S1.p1.1.13\" class=\"ltx_text\" style=\"font-size:90%;\">.\n246\tTypically, a single (average or median) mask is used for all microphone signals to estimate the speech and noise covariance matrix.\n247\tThe use of a single mask is a reasonable choice for compact arrays where all microphones typically capture signals with similar powers and signal-to-noise ratios (SNRs). However, in the case of spatially distributed microphones, signal characteristics (power, SNR, direct-to-reverberation ratio) may vary strongly across microphones </span><cite class=\"ltx_cite ltx_citemacro_cite\"><span id=\"S1.p1.1.14.1\" class=\"ltx_text\" style=\"font-size:90%;\">[</span><a href=\"#bib.bib146\" title=\"DNN-based mask estimation for distributed speech enhancement in spatially unconstrained microphone arrays\" class=\"ltx_ref\">7</a>, <a href=\"#bib.bib67\" title=\"Adaptive binaural filtering for a multiple-talker listening system using remote and on-ear microphones\" class=\"ltx_ref\">2</a>, <a href=\"#bib.bib98\" title=\"Relative transfer function vector estimation for acoustic sensor networks exploiting covariance matrix structure\" class=\"ltx_ref\">16</a>, <a href=\"#bib.bib135\" title=\"One-shot distributed node-specific signal estimation with non-overlapping latent subspaces in acoustic sensor networks\" class=\"ltx_ref\">4</a><span id=\"S1.p1.1.15.2\" class=\"ltx_text\" style=\"font-size:90%;\">]</span></cite><span id=\"S1.p1.1.16\" class=\"ltx_text\" style=\"font-size:90%;\">. In such a scenario, a single mask may be insufficient to optimally exploit the spatial diversity across microphones.</span></p>\n248\t</div>\n249\t<figure id=\"S1.F1\" class=\"ltx_figure\"><img src=\"2607.26623v1/x1.png\" id=\"S1.F1.g1\" class=\"ltx_graphics ltx_centering ltx_img_landscape\" width=\"592\" height=\"150\" alt=\"Refer to caption\">\n250\t<figcaption class=\"ltx_caption ltx_centering\" style=\"font-size:90%;\"><span class=\"ltx_tag ltx_tag_figure\"><span id=\"S1.F1.4.1.1\" class=\"ltx_text ltx_font_bold\">Fig. 1</span>: </span>Block diagram for single- and multi-channel mask-based beamforming. The mask selection block determines the characteristics of the mask vector.</figcaption>\n251\t</figure>\n252\t<div id=\"S1.p2\" class=\"ltx_para\">\n253\t<p id=\"S1.p2.1\" class=\"ltx_p\"><span id=\"S1.p2.1.1\" class=\"ltx_text\" style=\"font-size:90%;\">To improve the performance of mask-based beamforming for distributed microphones with high spatial diversity, in this paper we consider using multiple masks, i.e., applying a separate pre-filter to each microphone signal, shown in Fig. </span><a href=\"#S1.F1\" title=\"Figure 1 ‣ 1 Introduction ‣ A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones\" class=\"ltx_ref\" style=\"font-size:90%;\"><span class=\"ltx_text ltx_ref_tag\">1</span></a><span id=\"S1.p2.1.2\" class=\"ltx_text\" style=\"font-size:90%;\">.\n254\tThe scope of this paper is the assessment of the benefits and limitations of multi-channel masking compared to single masks rather than techniques for mask estimation.\n255\tIn </span><cite class=\"ltx_cite ltx_citemacro_cite\"><span id=\"S1.p2.1.3.1\" class=\"ltx_text\" style=\"font-size:90%;\">[</span><a href=\"#bib.bib136\" title=\"Improved MVDR beamforming using single-channel mask prediction networks\" class=\"ltx_ref\">6</a><span id=\"S1.p2.1.4.2\" class=\"ltx_text\" style=\"font-size:90%;\">]</span></cite><span id=\"S1.p2.1.5\" class=\"ltx_text\" style=\"font-size:90%;\">, a similar approach was proposed for the estimation of the noise covariance for compact arrays, where no significant benefit was observed. In </span><cite class=\"ltx_cite ltx_citemacro_cite\"><span id=\"S1.p2.1.6.1\" class=\"ltx_text\" style=\"font-size:90%;\">[</span><a href=\"#bib.bib145\" title=\"Complex spectral mapping for single-and multi-channel speech enhancement and robust ASR\" class=\"ltx_ref\">26</a>, <a href=\"#bib.bib137\" title=\"Beam-TasNet: time-domain audio separation network meets frequency-domain beamformer\" class=\"ltx_ref\">17</a><span id=\"S1.p2.1.7.2\" class=\"ltx_text\" style=\"font-size:90%;\">]</span></cite><span id=\"S1.p2.1.8\" class=\"ltx_text\" style=\"font-size:90%;\">, a DNN-based per-channel pre-filtering stage was proposed to enhance the performance of an automatic speech recognition system. However, the proposed pre-filtering strategies were only tested on compact arrays and made use of task-specific single-channel filters and not general masks.\n256\tIn this paper, we generalize the per-channel pre-filtering to a formulation of a multi-channel mask-based beamformer to account for the potential spatial diversity of distributed microphones. We compare three different masking approaches utilizing a single mask corresponding to the reference microphone, a mean mask across all microphones, and multi-channel masking, where an independent mask is applied to each microphone.\n257\tBecause distributed microphones are often used in complex sound scenes where source locations and activations change frequently, we consider a frame-by-frame online implementation. The adaptive beamformer is implemented using a sliding temporal window, for which we adopt a rank-2 covariance matrix update rule.</span></p>\n258\t</div>\n259\t<div id=\"S1.p3\" class=\"ltx_para\">\n260\t<p id=\"S1.p3.1\" class=\"ltx_p\"><span id=\"S1.p3.1.1\" class=\"ltx_text\" style=\"font-size:90%;\">In the evaluation, we provide a comprehensive study on the benefits and limitations of multi-channel masking in an online implementation and investigate the effects of different temporal contexts.\n261\tThe results show little difference for compact arrays, but a benefit of multi-channel masking over using a mean mask for distributed microphones, especially in scenarios where the noise sources are mostly captured by different nearby microphones.\n262\tTo assess the robustness of multi-channel masking, we compare the performance using an ideal ratio mask and a DNN-based mask estimator and demonstrate that for a realistic mask estimator the multi-channel masking approach outperforms single masks, especially at low input signal-to-noise ratios.</span></p>\n263\t</div>\n264\t</section>\n265\t<section id=\"S2\" class=\"ltx_section\">\n266\t<h2 class=\"ltx_title ltx_title_section\" style=\"font-size:90%;\">\n267\t<span class=\"ltx_tag ltx_tag_section\">2 </span>Signal Model</h2>\n268\t\n269\t<div id=\"S2.p1\" class=\"ltx_para\">\n270\t<p id=\"S2.p1.3\" class=\"ltx_p\"><span id=\"S2.p1.3.1\" class=\"ltx_text\" style=\"font-size:90%;\">We consider a single target speaker in a noisy and reverberant environment, recorded by </span><math id=\"S2.p1.1.m1\" class=\"ltx_Math\" alttext=\"M\" display=\"inline\" intent=\":literal\"><semantics><mi mathsize=\"0.900em\">M</mi><annotation encoding=\"application/x-tex\">M</annotation></semantics></math><span id=\"S2.p1.3.2\" class=\"ltx_text\" style=\"font-size:90%;\"> spatially distributed microphones with an arbitrary geometry.\n271\tIn the short-time Fourier transform (STFT) domain, the </span><math id=\"S2.p1.2.m2\" class=\"ltx_Math\" alttext=\"m\" display=\"inline\" intent=\":literal\"><semantics><mi mathsize=\"0.900em\">m</mi><annotation encoding=\"application/x-tex\">m</annotation></semantics></math><span id=\"S2.p1.3.3\" class=\"ltx_text\" style=\"font-size:90%;\">-th microphone signal </span><math id=\"S2.p1.3.m3\" class=\"ltx_Math\" alttext=\"Y_{m}(k,l)\" display=\"inline\" intent=\":literal\"><semantics><mrow><msub><mi mathsize=\"0.900em\">Y</mi><mi mathsize=\"0.900em\">m</mi></msub><mo lspace=\"0em\" rspace=\"0em\">​</mo><mrow><mo maxsize=\"0.900em\" minsize=\"0.900em\">(</mo><mi mathsize=\"0.900em\">k</mi><mo mathsize=\"0.900em\">,</mo><mi mathsize=\"0.900em\">l</mi><mo maxsize=\"0.900em\" minsize=\"0.900em\">)</mo></mrow></mrow><annotation encoding=\"application/x-tex\">Y_{m}(k,l)</annotation></semantics></math><span id=\"S2.p1.3.4\" class=\"ltx_text\" style=\"font-size:90%;\"> is given by</span></p>\n272\t<table id=\"S2.E1\" class=\"ltx_equation ltx_eqn_table\">\n273\t\n274\t<tbody><tr class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n275\t<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n276\t<td class=\"ltx_eqn_cell ltx_align_center\"><math id=\"S2.E1.m1\" class=\"ltx_Math\" alttext=\"Y_{m}(k,l)=X_{m}(k,l)+N_{m}(k,l)\\,,\\quad m\\in\\{1,\\dots,M\\}\\,,\" display=\"block\" intent=\":literal\"><semantics><mrow><mrow><mrow><mrow><msub><mi mathsize=\"0.900em\">Y</mi><mi mathsize=\"0.900em\">m</mi></msub><mo lspace=\"0em\" rspace=\"0em\">​</mo><mrow><mo maxsize=\"0.900em\" minsize=\"0.900em\">(</mo><mi mathsize=\"0.900em\">k</mi><mo mathsize=\"0.900em\">,</mo><mi mathsize=\"0.900em\">l</mi><mo maxsize=\"0.900em\" minsize=\"0.900em\">)</mo></mrow></mrow><mo mathsize=\"0.900em\">=</mo><mrow><mrow><msub><mi mathsize=\"0.900em\">X</mi><mi mathsize=\"0.900em\">m</mi></msub><mo lspace=\"0em\" rspace=\"0em\">​</mo><mrow><mo maxsize=\"0.900em\" minsize=\"0.900em\">(</mo><mi mathsize=\"0.900em\">k</mi><mo mathsize=\"0.900em\">,</mo><mi mathsize=\"0.900em\">l</mi><mo maxsize=\"0.900em\" minsize=\"0.900em\">)</mo></mrow></mrow><mo mathsize=\"0.900em\">+</mo><mrow><msub><mi mathsize=\"0.900em\">N</mi><mi mathsize=\"0.900em\">m</mi></msub><mo lspace=\"0em\" rspace=\"0em\">​</mo><mrow><mo maxsize=\"0.900em\" minsize=\"0.900em\">(</mo><mi mathsize=\"0.900em\">k</mi><mo mathsize=\"0.900em\">,</mo><mi mathsize=\"0.900em\">l</mi><mo maxsize=\"0.900em\" minsize=\"0.900em\" rspace=\"0.170em\">)</mo></mrow></mrow></mrow></mrow><mo mathsize=\"0.900em\" rspace=\"1.087em\">,</mo><mrow><mi mathsize=\"0.900em\">m</mi><mo mathsize=\"0.900em\">∈</mo><mrow><mo maxsize=\"0.900em\" minsize=\"0.900em\">{</mo><mn mathsize=\"0.900em\">1</mn><mo mathsize=\"0.900em\">,</mo><mi mathsize=\"0.900em\" mathvariant=\"normal\">…</mi><mo mathsize=\"0.900em\">,</mo><mi mathsize=\"0.900em\">M</mi><mo maxsize=\"0.900em\" minsize=\"0.900em\" rspace=\"0.170em\">}</mo></mrow></mrow></mrow><mo mathsize=\"0.900em\">,</mo></mrow><annotation encoding=\"application/x-tex\">Y_{m}(k,l)=X_{m}(k,l)+N_{m}(k,l)\\,,\\quad m\\in\\{1,\\dots,M\\}\\,,</annotation></semantics></math></td>\n277\t<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td>\n278\t<td rowspan=\"1\" class=\"ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right\"><span class=\"ltx_tag ltx_tag_equation ltx_align_right\">(1)</span></td>\n279\t</tr></tbody>\n280\t</table>\n281\t<p id=\"S2.p1.16\" class=\"ltx_p\"><span id=\"S2.p1.16.1\" class=\"ltx_text\" style=\"font-size:90%;\">where </span><math id=\"S2.p1.4.m1\" class=\"ltx_Math\" alttext=\"X_{m}(k,l)\" display=\"inline\" intent=\":literal\"><semantics><mrow><msub><mi mathsize=\"0.900em\">X</mi><mi mathsize=\"0.900em\">m</mi></msub><mo lspace=\"0em\" rspace=\"0em\">​</mo><mrow><mo maxsize=\"0.900em\" minsize=\"0.900em\">(</mo><mi mathsize=\"0.900em\">k</mi><mo mathsize=\"0.900em\">,</mo><mi mathsize=\"0.900em\">l</mi><mo maxsize=\"0.900em\" minsize=\"0.900em\">)</mo></mrow></mrow><annotation encoding=\"application/x-tex\">X_{m}(k,l)</annotation></semantics></math><span id=\"S2.p1.16.2\" class=\"ltx_text\" style=\"font-size:90%;\"> and </span><math id=\"S2.p1.5.m2\" class=\"ltx_Math\" alttext=\"N_{m}(k,l)\" display=\"inline\" intent=\":literal\"><semantics><mrow><msub><mi mathsize=\"0.900em\">N</mi><mi mathsize=\"0.900em\">m</mi></msub><mo lspace=\"0em\" rspace=\"0em\">​</mo><mrow><mo maxsize=\"0.900em\" minsize=\"0.900em\">(</mo><mi mathsize=\"0.900em\">k</mi><mo mathsize=\"0.900em\">,</mo><mi mathsize=\"0.900em\">l</mi><mo maxsize=\"0.900em\" minsize=\"0.900em\">)</mo></mrow></mrow><annotation encoding=\"application/x-tex\">N_{m}(k,l)</annotation></semantics></math><span id=\"S2.p1.16.3\" class=\"ltx_text\" style=\"font-size:90%;\"> are the zero-mean target speech component and the noise component in the </span><math id=\"S2.p1.6.m3\" class=\"ltx_Math\" alttext=\"m\" display=\"inline\" intent=\":literal\"><semantics><mi mathsize=\"0.900em\">m</mi><annotation encoding=\"application/x-tex\">m</annotation></semantics></math><span id=\"S2.p1.16.4\" class=\"ltx_text\" style=\"font-size:90%;\">-th microphone, respectively, and </span><math id=\"S2.p1.7.m4\" class=\"ltx_Math\" alttext=\"k\" display=\"inline\" intent=\":literal\"><semantics><mi mathsize=\"0.900em\">k</mi><annotation encoding=\"application/x-tex\">k</annotation></semantics></math><span id=\"S2.p1.16.5\" class=\"ltx_text\" style=\"font-size:90%;\"> and </span><math id=\"S2.p1.8.m5\" class=\"ltx_Math\" alttext=\"l\" display=\"inline\" intent=\":literal\"><semantics><mi mathsize=\"0.900em\">l</mi><annotation encoding=\"application/x-tex\">l</annotation></semantics></math><span id=\"S2.p1.16.6\" class=\"ltx_text\" style=\"font-size:90%;\"> denote the frequency bin and frame index. In the following, we will omit </span><math id=\"S2.p1.9.m6\" class=\"ltx_Math\" alttext=\"k\" display=\"inline\" intent=\":literal\"><semantics><mi mathsize=\"0.900em\">k</mi><annotation encoding=\"application/x-tex\">k</annotation></semantics></math><span id=\"S2.p1.16.7\" class=\"ltx_text\" style=\"font-size:90%;\"> and </span><math id=\"S2.p1.10.m7\" class=\"ltx_Math\" alttext=\"l\" display=\"inline\" intent=\":literal\"><semantics><mi mathsize=\"0.900em\">l</mi><annotation encoding=\"application/x-tex\">l</annotation></semantics></math><span id=\"S2.p1.16.8\" class=\"ltx_text\" style=\"font-size:90%;\"> wherever possible.\n282\tThe noisy signal vector, </span><math id=\"S2.p1.11.m8\" class=\"ltx_Math\" alttext=\"\\mathbf{y}=[Y_{1},Y_{2},\\dots,Y_{M}]^{T}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi mathsize=\"0.900em\">𝐲</mi><mo mathsize=\"0.900em\">=</mo><msup><mrow><mo maxsize=\"0.900em\" minsize=\"0.900em\">[</mo><msub><mi mathsize=\"0.900em\">Y</mi><mn mathsize=\"0.900em\">1</mn></msub><mo mathsize=\"0.900em\">,</mo><msub><mi mathsize=\"0.900em\">Y</mi><mn mathsize=\"0.900em\">2</mn></msub><mo mathsize=\"0.900em\">,</mo><mi mathsize=\"0.900em\" mathvariant=\"normal\">…</mi><mo mathsize=\"0.900em\">,</mo><msub><mi mathsize=\"0.900em\">Y</mi><mi mathsize=\"0.900em\">M</mi></msub><mo maxsize=\"0.900em\" minsize=\"0.900em\">]</mo></mrow><mi mathsize=\"0.900em\">T</mi></msup></mrow><annotation encoding=\"application/x-tex\">\\mathbf{y}=[Y_{1},Y_{2},\\dots,Y_{M}]^{T}</annotation></semantics></math><span id=\"S2.p1.16.9\" class=\"ltx_text\" style=\"font-size:90%;\"> with </span><math id=\"S2.p1.12.m9\" class=\"ltx_Math\" alttext=\"\\{\\cdot\\}^{T}\" display=\"inline\" intent=\":literal\"><semantics><msup><mrow><mo maxsize=\"0.900em\" minsize=\"0.900em\">{</mo><mo lspace=\"0em\" mathsize=\"0.900em\" rspace=\"0em\">⋅</mo><mo maxsize=\"0.900em\" minsize=\"0.900em\">}</mo></mrow><mi mathsize=\"0.900em\">T</mi></msup><annotation encoding=\"application/x-tex\">\\{\\cdot\\}^{T}</annotation></semantics></math><span id=\"S2.p1.16.10\" class=\"ltx_text\" style=\"font-size:90%;\"> the transpose operator, can be written as </span><math id=\"S2.p1.13.m10\" class=\"ltx_Math\" alttext=\"\\mathbf{y}=\\mathbf{x}+\\mathbf{n}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi mathsize=\"0.900em\">𝐲</mi><mo mathsize=\"0.900em\">=</mo><mrow><mi mathsize=\"0.900em\">𝐱</mi><mo mathsize=\"0.900em\">+</mo><mi mathsize=\"0.900em\">𝐧</mi></mrow></mrow><annotation encoding=\"application/x-tex\">\\mathbf{y}=\\mathbf{x}+\\mathbf{n}</annotation></semantics></math><span id=\"S2.p1.16.11\" class=\"ltx_text\" style=\"font-size:90%;\">,\n283\twhere </span><math id=\"S2.p1.14.m11\" class=\"ltx_Math\" alttext=\"\\mathbf{x}\" display=\"inline\" intent=\":literal\"><semantics><mi mathsize=\"0.900em\">𝐱</mi><annotation encoding=\"application/x-tex\">\\mathbf{x}</annotation></semantics></math><span id=\"S2.p1.16.12\" class=\"ltx_text\" style=\"font-size:90%;\"> and </span><math id=\"S2.p1.15.m12\" class=\"ltx_Math\" alttext=\"\\mathbf{n}\" display=\"inline\" intent=\":literal\"><semantics><mi mathsize=\"0.900em\">𝐧</mi><annotation encoding=\"application/x-tex\">\\mathbf{n}</annotation></semantics></math><span id=\"S2.p1.16.13\" class=\"ltx_text\" style=\"font-size:90%;\"> are the speech and noise vector, defined similarly as </span><math id=\"S2.p1.16.m13\" class=\"ltx_Math\" alttext=\"\\mathbf{y}\" display=\"inline\" intent=\":literal\"><semantics><mi mathsize=\"0.900em\">𝐲</mi><annotation encoding=\"application/x-tex\">\\mathbf{y}</annotation></semantics></math><span id=\"S2.p1.16.14\" class=\"ltx_text\" style=\"font-size:90%;\">.\n284\tAssuming statistical independence between speech and noise, the noisy covariance matrix is given by</span></p>\n285\t<table id=\"S2.E2\" class=\"ltx_equation ltx_eqn_table\">\n286\t\n287\t<tbody><tr class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n288\t<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n289\t<td class=\"ltx_eqn_cell ltx_align_center\"><math id=\"S2.E2.m1\" class=\"ltx_Math\" alttext=\"\\mathbf{R}_{y}=\\mathcal{E}\\{\\mathbf{y}\\mathbf{y}^{H}\\}=\\mathbf{R}_{x}+\\mathbf{R}_{n}\\,,\" display=\"block\" intent=\":literal\"><semantics><mrow><mrow><msub><mi mathsize=\"0.900em\">𝐑</mi><mi mathsize=\"0.900em\">y</mi></msub><mo mathsize=\"0.900em\">=</mo><mrow><mi class=\"ltx_font_mathcaligraphic\" mathsize=\"0.900em\">ℰ</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mrow><mo maxsize=\"0.900em\" minsize=\"0.900em\">{</mo><msup><mi mathsize=\"0.900em\">𝐲𝐲</mi><mi mathsize=\"0.900em\">H</mi></msup><mo maxsize=\"0.900em\" minsize=\"0.900em\">}</mo></mrow></mrow><mo mathsize=\"0.900em\">=</mo><mrow><msub><mi mathsize=\"0.900em\">𝐑</mi><mi mathsize=\"0.900em\">x</mi></msub><mo mathsize=\"0.900em\">+</mo><msub><mi mathsize=\"0.900em\">𝐑</mi><mi mathsize=\"0.900em\">n</mi></msub></mrow></mrow><mo mathsize=\"0.900em\">,</mo></mrow><annotation encoding=\"application/x-tex\">\\mathbf{R}_{y}=\\mathcal{E}\\{\\mathbf{y}\\mathbf{y}^{H}\\}=\\mathbf{R}_{x}+\\mathbf{R}_{n}\\,,</annotation></semantics></math></td>\n290\t<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td>\n291\t<td rowspan=\"1\" class=\"ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right\"><span class=\"ltx_tag ltx_tag_equation ltx_align_right\">(2)</span></td>\n292\t</tr></tbody>\n293\t</table>\n294\t<p id=\"S2.p1.21\" class=\"ltx_p\"><span id=\"S2.p1.21.1\" class=\"ltx_text\" style=\"font-size:90%;\">where </span><math id=\"S2.p1.17.m1\" class=\"ltx_Math\" alttext=\"\\mathbf{R}_{x}\" display=\"inline\" intent=\":literal\"><semantics><msub><mi mathsize=\"0.900em\">𝐑</mi><mi mathsize=\"0.900em\">x</mi></msub><annotation encoding=\"application/x-tex\">\\mathbf{R}_{x}</annotation></semantics></math><span id=\"S2.p1.21.2\" class=\"ltx_text\" style=\"font-size:90%;\"> and </span><math id=\"S2.p1.18.m2\" class=\"ltx_Math\" alttext=\"\\mathbf{R}_{n}\" display=\"inline\" intent=\":literal\"><semantics><msub><mi mathsize=\"0.900em\">𝐑</mi><mi mathsize=\"0.900em\">n</mi></msub><annotation encoding=\"application/x-tex\">\\mathbf{R}_{n}</annotation></semantics></math><span id=\"S2.p1.21.3\" class=\"ltx_text\" style=\"font-size:90%;\"> are the speech and noise covariance matrices, respectively. </span><math id=\"S2.p1.19.m3\" class=\"ltx_Math\" alttext=\"\\mathcal{E}\\{\\cdot\\}\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi class=\"ltx_font_mathcaligraphic\" mathsize=\"0.900em\">ℰ</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><mrow><mo maxsize=\"0.900em\" minsize=\"0.900em\">{</mo><mo lspace=\"0em\" mathsize=\"0.900em\" rspace=\"0em\">⋅</mo><mo maxsize=\"0.900em\" minsize=\"0.900em\">}</mo></mrow></mrow><annotation encoding=\"application/x-tex\">\\mathcal{E}\\{\\cdot\\}</annotation></semantics></math><span id=\"S2.p1.21.4\" class=\"ltx_text\" style=\"font-size:90%;\"> is the expectation operator, and </span><math id=\"S2.p1.20.m4\" class=\"ltx_Math\" alttext=\"\\{\\cdot\\}^{H}\" display=\"inline\" intent=\":literal\"><semantics><msup><mrow><mo maxsize=\"0.900em\" minsize=\"0.900em\">{</mo><mo lspace=\"0em\" mathsize=\"0.900em\" rspace=\"0em\">⋅</mo><mo maxsize=\"0.900em\" minsize=\"0.900em\">}</mo></mrow><mi mathsize=\"0.900em\">H</mi></msup><annotation encoding=\"application/x-tex\">\\{\\cdot\\}^{H}</annotation></semantics></math><span id=\"S2.p1.21.5\" class=\"ltx_text\" style=\"font-size:90%;\"> is the Hermitian transpose operator.\n295\tThe noise covariance matrix </span><math id=\"S2.p1.21.m5\" class=\"ltx_Math\" alttext=\"\\mathbf{R}_{n}\" display=\"inline\" intent=\":literal\"><semantics><msub><mi mathsize=\"0.900em\">𝐑</mi><mi mathsize=\"0.900em\">n</mi></msub><annotation encoding=\"application/x-tex\">\\mathbf{R}_{n}</annotation></semantics></math><span id=\"S2.p1.21.6\" class=\"ltx_text\" style=\"font-size:90%;\"> is assumed to be full-rank but not following any particular spatial distribution.\n296\tIt should be noted that in a scenario with distributed microphones, different microphones might capture different noise sources. Hence, there may be a low correlation between the noise components in different microphones </span><cite class=\"ltx_cite ltx_citemacro_cite\"><span id=\"S2.p1.21.7.1\" class=\"ltx_text\" style=\"font-size:90%;\">[</span><a href=\"#bib.bib98\" title=\"Relative transfer function vector estimation for acoustic sensor networks exploiting covariance matrix structure\" class=\"ltx_ref\">16</a><span id=\"S2.p1.21.8.2\" class=\"ltx_text\" style=\"font-size:90%;\">]</span></cite><span id=\"S2.p1.21.9\" class=\"ltx_text\" style=\"font-size:90%;\"> and the noise power spectral density and SNR may vary across microphones.</span></p>\n297\t</div>\n298\t<div id=\"S2.p2\" class=\"ltx_para\">\n299\t<p id=\"S2.p2.6\" class=\"ltx_p\"><span id=\"S2.p2.6.1\" class=\"ltx_text\" style=\"font-size:90%;\">A popular geometry-agnostic signal-dependent spatial filter is the MVDR beamformer, which can be written in terms of the covariance matrices </span><cite class=\"ltx_cite ltx_citemacro_cite\"><span id=\"S2.p2.6.2.1\" class=\"ltx_text\" style=\"font-size:90%;\">[</span><a href=\"#bib.bib156\" title=\"A study of the LCMV and MVDR noise reduction filters\" class=\"ltx_ref\">23</a><span id=\"S2.p2.6.3.2\" class=\"ltx_text\" style=\"font-size:90%;\">]</span></cite><span id=\"S2.p2.6.4\" class=\"ltx_text\" style=\"font-size:90%;\"> as</span></p>\n300\t<table id=\"S2.E3\" class=\"ltx_equation ltx_eqn_table\">\n301\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]}, "parent_tool_use_id": null, "session_id": "02e6482f-5413-4b74-98c2-3273295bf3a2", "uuid": "1b8b2ea4-7135-45eb-831e-863fbd7506cf", "timestamp": "2026-07-30T07:53:33.756Z", "tool_use_result": {"type": "text", "file": {"filePath": "/inspire/qb-ilm/project/video-generation/chenxie-25019/hyr/iHateTheWorld555.github.io/.claude-review/projects/-inspire-qb-ilm-project-video-generation-chenxie-25019-hyr-iHateTheWorld555-github-io/02e6482f-5413-4b74-98c2-3273295bf3a2/tool-results/b8c65boof.txt", "content": "<!DOCTYPE html><html lang=\"en\">\n<head>\n<meta http-equiv=\"content-type\" content=\"text/html; charset=UTF-8\">\n<title>A Study on Online Mask-based Beamforming Using Per-channel Masking for Spatially Distributed Microphones</title>\n<!--Generated on Wed Jul 29 08:47:02 2026 by LaTeXML (version 0.8.8) http://dlmf.nist.gov/LaTeXML/.-->\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\">\n<link rel=\"stylesheet\" href=\"/static/browse/0.3.4/css/arxiv-html-papers-20260131.css\" type=\"text/css\">\n<script src=\"/static/browse/0.3.4/js/arxiv-html-papers-20260131.js\"></script>\n<script>\n  // Restore the saved color scheme preference, or\n  // en