{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "chatcmpl-tool-845562e6fe6f4b46", "type": "tool_result", "content": "EXIT=0\n\n\n\n<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n  <head>\n  \n    \n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"google-site-verification\" content=\"5fPGCLllnWrvFxH9QWI0l1TadV7byeEvfPcyK2VkS_s\"/>\n    <meta name=\"google-site-verification\" content=\"Rp5zp04IKW-s1IbpTOGB7Z6XY60oloZD5C3kTM-AiY4\"/>\n\n    \n    \n    <meta name=\"generator\" content=\"InvenioRDM 15.0\"/>\n\n    \n    \n    \n \n    <meta name=\"citation_title\" content=\"AASD: An Open Non-Invasive EEG Dataset for Spontaneous Auditory Attention Switch Decoding\" />\n    <meta name=\"citation_abstract_html_url\" content=\"https://zenodo.org/records/17413336\" />\n    <meta property=\"og:title\" content=\"AASD: An Open Non-Invasive EEG Dataset for Spontaneous Auditory Attention Switch Decoding\" />\n    <meta name=\"twitter:title\" content=\"AASD: An Open Non-Invasive EEG Dataset for Spontaneous Auditory Attention Switch Decoding\" />\n      <title>AASD: An Open Non-Invasive EEG Dataset for Spontaneous Auditory Attention Switch Decoding | Zenodo</title>\n                      <span class=\"ui\" title=\"Publication date\">\n              <div class=\"ui divider hidden\"></div><section id=\"record-title-section\"\n                       aria-label=\"Record title, authors and contributors\">\n                <h1 id=\"record-title\"\n    <h2 id=\"description-heading\" class=\"sr-only\">Description</h2>\n    ><h2 id=\"files-heading\">Files</h2>\n    <h3 class=\"active title panel-heading open m-0\">\n        <span id=\"preview-file-title\">Stimuli Audio.zip</span>\n    title=\"Preview\"\n    <h3 class=\"active title panel-heading open m-0\">\n  <h2 id=\"record-details-heading\">Additional details</h2>\n  <div class=\"title trigger\" tabindex=\"0\">\n  <h2 class=\"ui medium top attached header mt-0\">Versions</h2>\n      <div id=\"recordVersions\" data-record='{\"access\": {\"embargo\": {\"active\": false, \"reason\": null}, \"files\": \"public\", \"record\": \"public\", \"status\": \"open\"}, \"created\": \"2025-10-22T09:06:10.513395+00:00\", \"custom_fields\": {}, \"deletion_status\": {\"is_deleted\": false, \"status\": \"P\"}, \"expanded\": {\"parent\": {\"access\": {\"owned_by\": {\"active\": null, \"blocked_at\": null, \"confirmed_at\": null, \"email\": \"\", \"id\": \"1440008\", \"is_current_user\": false, \"links\": {\"avatar\": \"https://zenodo.org/api/users/1440008/avatar.svg\", \"records_html\": \"https://zenodo.org/search?q=parent.access.owned_by.user:1440008\", \"self\": \"https://zenodo.org/api/users/1440008\"}, \"profile\": {\"affiliations\": \"Southern University of Science and technology\", \"full_name\": \"Xuefei Wang\"}, \"username\": \"Xuefei\", \"verified_at\": null}}}}, \"files\": {\"count\": 3, \"default_preview\": \"Stimuli Audio.zip\", \"enabled\": true, \"entries\": {\"Original EEG.zip\": {\"access\": {\"hidden\": false}, \"checksum\": \"md5:1e4760203e1c47ea84e199b1b782ee3f\", \"ext\": \"zip\", \"id\": \"fdfe12db-64fd-4e83-9277-61e4e481e7e2\", \"key\": \"Original EEG.zip\", \"links\": {\"container\": \"https://zenodo.org/api/records/17413336/files/Original%20EEG.zip/container\", \"content\": \"https://zenodo.org/api/records/17413336/files/Original%20EEG.zip/content\", \"self\": \"https://zenodo.org/api/records/17413336/files/Original%20EEG.zip\"}, \"metadata\": {}, \"mimetype\": \"application/zip\", \"size\": 10802976788, \"storage_class\": \"L\"}, \"Processed EEG.zip\": {\"access\": {\"hidden\": false}, \"checksum\": \"md5:8ed97d44056d6b0c34ffd9505624adce\", \"ext\": \"zip\", \"id\": \"0e9001bc-bd72-4a21-8e61-0f3a7423489d\", \"key\": \"Processed EEG.zip\", \"links\": {\"container\": \"https://zenodo.org/api/records/17413336/files/Processed%20EEG.zip/container\", \"content\": \"https://zenodo.org/api/records/17413336/files/Processed%20EEG.zip/content\", \"self\": \"https://zenodo.org/api/records/17413336/files/Processed%20EEG.zip\"}, \"metadata\": {}, \"mimetype\": \"application/zip\", \"size\": 1872638444, \"storage_class\": \"L\"}, \"Stimuli Audio.zip\": {\"access\": {\"hidden\": false}, \"checksum\": \"md5:e0be11ebc667da4a739b208de89b9182\", \"ext\": \"zip\", \"id\": \"2be1b0ee-8326-49ff-92cc-7f2ecd027c1d\", \"key\": \"Stimuli Audio.zip\", \"links\": {\"container\": \"https://zenodo.org/api/records/17413336/files/Stimuli%20Audio.zip/container\", \"content\": \"https://zenodo.org/api/records/17413336/files/Stimuli%20Audio.zip/content\", \"self\": \"https://zenodo.org/api/records/17413336/files/Stimuli%20Audio.zip\"}, \"metadata\": {}, \"mimetype\": \"application/zip\", \"size\": 193464233, \"storage_class\": \"L\"}}, \"order\": [], \"total_bytes\": 12869079465}, \"id\": \"17413336\", \"is_draft\": false, \"is_published\": true, \"links\": {\"access\": \"https://zenodo.org/api/records/17413336/access\", \"access_grants\": \"https://zenodo.org/api/records/17413336/access/grants\", \"access_links\": \"https://zenodo.org/api/records/17413336/access/links\", \"access_request\": \"https://zenodo.org/api/records/17413336/access/request\", \"access_users\": \"https://zenodo.org/api/records/17413336/access/users\", \"archive\": \"https://zenodo.org/api/records/17413336/files-archive\", \"archive_media\": \"https://zenodo.org/api/records/17413336/media-files-archive\", \"communities\": \"https://zenodo.org/api/records/17413336/communities\", \"communities-suggestions\": \"https://zenodo.org/api/records/17413336/communities-suggestions\", \"doi\": \"https://doi.org/10.5281/zenodo.17413336\", \"draft\": \"https://zenodo.org/api/records/17413336/draft\", \"file_modification\": \"https://zenodo.org/api/records/17413336/file-modification\", \"files\": \"https://zenodo.org/api/records/17413336/files\", \"latest\": \"https://zenodo.org/api/records/17413336/versions/latest\", \"latest_html\": \"https://zenodo.org/records/17413336/latest\", \"media_files\": \"https://zenodo.org/api/records/17413336/media-files\", \"parent\": \"https://zenodo.org/api/records/17413335\", \"parent_doi\": \"https://doi.org/10.5281/zenodo.17413335\", \"parent_doi_html\": \"https://zenodo.org/doi/10.5281/zenodo.17413335\", \"parent_html\": \"https://zenodo.org/records/17413335\", \"preview_html\": \"https://zenodo.org/records/17413336?preview=1\", \"quota_increase\": \"https://zenodo.org/api/records/17413336/quota-increase\", \"request_deletion\": \"https://zenodo.org/api/records/17413336/request-deletion\", \"requests\": \"https://zenodo.org/api/records/17413336/requests\", \"reserve_doi\": \"https://zenodo.org/api/records/17413336/draft/pids/doi\", \"self\": \"https://zenodo.org/api/records/17413336\", \"self_doi\": \"https://doi.org/10.5281/zenodo.17413336\", \"self_doi_html\": \"https://zenodo.org/doi/10.5281/zenodo.17413336\", \"self_html\": \"https://zenodo.org/records/17413336\", \"self_iiif_manifest\": \"https://zenodo.org/api/iiif/record:17413336/manifest\", \"self_iiif_sequence\": \"https://zenodo.org/api/iiif/record:17413336/sequence/default\", \"versions\": \"https://zenodo.org/api/records/17413336/versions\"}, \"media_files\": {\"count\": 0, \"enabled\": false, \"entries\": {}, \"order\": [], \"total_bytes\": 0}, \"metadata\": {\"creators\": [{\"person_or_org\": {\"family_name\": \"Wang\", \"given_name\": \"Xuefei\", \"name\": \"Wang, Xuefei\", \"type\": \"personal\"}}, {\"person_or_org\": {\"family_name\": \"Ding\", \"given_name\": \"Yuting\", \"name\": \"Ding, Yuting\", \"type\": \"personal\"}}, {\"person_or_org\": {\"family_name\": \"Ban\", \"given_name\": \"Yueting\", \"name\": \"Ban, Yueting\", \"type\": \"personal\"}}, {\"person_or_org\": {\"family_name\": \"Wang\", \"given_name\": \"Lei\", \"name\": \"Wang, Lei\", \"type\": \"personal\"}}, {\"person_or_org\": {\"family_name\": \"Chen\", \"given_name\": \"Fei\", \"name\": \"Chen, Fei\", \"type\": \"personal\"}}], \"description\": \"\\u003cp\\u003eThe Auditory Attention Switching Dataset (AASD) provides a large-scale, open-access collection of electroencephalography (EEG) recordings designed to investigate spontaneous auditory attention switching in natural listening environments. This dataset fills a critical gap in auditory brain\\u0026ndash;computer interface research by capturing neural dynamics during spontaneous attention switch rather than externally cued transitions. The AASD enables the study of natural auditory attention mechanisms and supports the development of robust neural decoding algorithms for real-world applications.\\u003c/p\\u003e\\n\\u003ch3\\u003e\\u003cstrong\\u003eParticipants and Ethical Approval\\u003c/strong\\u003e\\u003c/h3\\u003e\\n\\u003cp\\u003eEighteen healthy volunteers aged between 18 and 27 years participated in this study. All participants were native Mandarin speakers with normal hearing and no neurological or psychiatric history. The experimental procedures were reviewed and approved by the Ethical Review Board of the Southern University of Science and Technology (Approval No. 2022DZX003). Each participant provided written informed consent and explicitly agreed to the public sharing of their anonymized data. All personally identifiable information was removed to ensure complete data privacy.\\u003c/p\\u003e\\n\\u003ch3\\u003e\\u003cstrong\\u003eExperimental Design and Procedure\\u003c/strong\\u003e\\u003c/h3\\u003e\\n\\u003cp\\u003eEach participant completed \\u003cstrong\\u003e60 trials\\u003c/strong\\u003e (60 s each) organized into six randomized attention-switching blocks of 10. Two narrative speech streams, one male and one female, were simultaneously presented through headphones at \\u0026plusmn;90\\u0026deg; azimuth using head-related transfer functions (HRTFs) to simulate spatial separation.\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eIn half the trials, male speech was presented to the left ear and female to the right; in the remaining half, the configuration was reversed.\\u003c/li\\u003e\\n\\u003cli\\u003eParticipants \\u003cstrong\\u003efreely chose\\u003c/strong\\u003e which stream to attend to and could \\u003cstrong\\u003espontaneously switch\\u003c/strong\\u003e attention between them, pressing a button to mark each switch.\\u003c/li\\u003e\\n\\u003cli\\u003eEach session lasted approximately\\u003cstrong\\u003e \\u003c/strong\\u003e150 minutes, including setup, training, and rest breaks between blocks.\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003eIn addition to the main attention-switching blocks, a passive listening control condition was conducted as the final block (\\u003cstrong\\u003e10 trials\\u003c/strong\\u003e). \\u0026nbsp;During this block, participants did not perform voluntary auditory attention switching but were instructed to press the response keys alternately at a rate that roughly matched the switching frequency observed during their previous blocks.\\u003c/p\\u003e\\n\\u003cp\\u003eThe system synchronized all EEG, audio, and behavioral markers to achieve precise temporal alignment of attention labels.\\u003c/p\\u003e\\n\\u003ch3\\u003e\\u003cstrong\\u003eDataset and Code Release:\\u003c/strong\\u003e\\u003c/h3\\u003e\\n\\u003cp\\u003eThis public release provides the complete Auditory Attention Switching Dataset (AASD) for research use. The dataset includes EEG recordings, synchronized auditory stimuli, and behavioral markers collected from all eighteen participants. Each participant completed sixty trials of sixty seconds, involving self-initiated attention switches between two spatialized speech streams.\\u003c/p\\u003e\\n\\u003cp\\u003eThis release contains:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eEEG recordings from sixty-four channels under spatialized dual-speaker listening conditions.\\u003c/li\\u003e\\n\\u003cli\\u003eRaw EEG data in CNT format and preprocessed EEG data in MAT format, aligned with corresponding event triggers.\\u003c/li\\u003e\\n\\u003cli\\u003eSpatialized two-channel speech stimuli generated from the AISHELL Mandarin corpus (three male and three female speakers).\\u003c/li\\u003e\\n\\u003cli\\u003eTrial-level metadata including attention direction and button-press timestamps marking spontaneous switch events.\\u003c/li\\u003e\\n\\u003c/ul\\u003e\", \"languages\": [{\"id\": \"cmn\", \"title\": {\"en\": \"Mandarin Chinese\"}}], \"publication_date\": \"2025-10-22\", \"publisher\": \"Zenodo\", \"references\": [{\"reference\": \"H. Bu, J. Du, X. Na, B. Wu, and H. Zheng, \\\"Aishell-1: An open-source Mandarin speech corpus and a speech recognition baseline,\\\" in Proceedings of the 2017 Conference of the Oriental Chapter of the International Coordinating Committee on Speech Databases and Speech I/O Systems and Assessment (OCOCOSDA), 2017, pp. 1\\u20135.\"}], \"resource_type\": {\"id\": \"dataset\", \"title\": {\"de\": \"Datensatz\", \"en\": \"Dataset\"}}, \"rights\": [{\"description\": {\"en\": \"The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited.\"}, \"icon\": \"cc-by-icon\", \"id\": \"cc-by-4.0\", \"props\": {\"scheme\": \"spdx\", \"url\": \"https://creativecommons.org/licenses/by/4.0/legalcode\"}, \"title\": {\"en\": \"Creative Commons Attribution 4.0 International\"}}], \"subjects\": [{\"subject\": \"auditory brain\\u2013computer interface\"}, {\"subject\": \"spontaneous attention switching\"}, {\"subject\": \"auditory attention decoding\"}, {\"subject\": \"spatialized speech\"}, {\"subject\": \"electroencephalography (EEG)\"}], \"title\": \"AASD: An Open Non-Invasive EEG Dataset for Spontaneous Auditory Attention Switch Decoding\"}, \"parent\": {\"access\": {\"owned_by\": {\"user\": \"1440008\"}, \"settings\": {\"accept_conditions_text\": null, \"allow_guest_requests\": false, \"allow_user_requests\": false, \"secret_link_expiration\": 0}}, \"communities\": {}, \"id\": \"17413335\", \"pids\": {\"doi\": {\"client\": \"datacite\", \"identifier\": \"10.5281/zenodo.17413335\", \"provider\": \"datacite\"}}}, \"pids\": {\"doi\": {\"client\": \"datacite\", \"identifier\": \"10.5281/zenodo.17413336\", \"provider\": \"datacite\"}, \"oai\": {\"identifier\": \"oai:zenodo.org:17413336\", \"provider\": \"oai\"}}, \"revision_id\": 8, \"stats\": {\"all_versions\": {\"data_volume\": 9437358157901.0, \"downloads\": 3076, \"unique_downloads\": 384, \"unique_views\": 510, \"views\": 588}, \"this_version\": {\"data_volume\": 9437358157901.0, \"downloads\": 3076, \"unique_downloads\": 384, \"unique_views\": 510, \"views\": 588}}, \"status\": \"published\", \"swh\": {}, \"ui\": {\"access_status\": {\"description_l10n\": \"The record and files are publicly accessible.\", \"embargo_date_l10n\": null, \"icon\": \"unlock\", \"id\": \"open\", \"message_class\": \"\", \"title_l10n\": \"Open\"}, \"created_date_l10n_long\": \"October 22, 2025\", \"creators\": {\"affiliations\": [], \"creators\": [{\"person_or_org\": {\"family_name\": \"Wang\", \"given_name\": \"Xuefei\", \"name\": \"Wang, Xuefei\", \"type\": \"personal\"}}, {\"person_or_org\": {\"family_name\": \"Ding\", \"given_name\": \"Yuting\", \"name\": \"Ding, Yuting\", \"type\": \"personal\"}}, {\"person_or_org\": {\"family_name\": \"Ban\", \"given_name\": \"Yueting\", \"name\": \"Ban, Yueting\", \"type\": \"personal\"}}, {\"person_or_org\": {\"family_name\": \"Wang\", \"given_name\": \"Lei\", \"name\": \"Wang, Lei\", \"type\": \"personal\"}}, {\"person_or_org\": {\"family_name\": \"Chen\", \"given_name\": \"Fei\", \"name\": \"Chen, Fei\", \"type\": \"personal\"}}]}, \"custom_fields\": {}, \"description_stripped\": \"The Auditory Attention Switching Dataset (AASD) provides a large-scale, open-access collection of electroencephalography (EEG) recordings designed to investigate spontaneous auditory attention switching in natural listening environments. This dataset fills a critical gap in auditory brain\\u2013computer interface research by capturing neural dynamics during spontaneous attention switch rather than externally cued transitions. The AASD enables the study of natural auditory attention mechanisms and supports the development of robust neural decoding algorithms for real-world applications.\\n\\nParticipants and Ethical Approval\\n\\nEighteen healthy volunteers aged between 18 and 27 years participated in this study. All participants were native Mandarin speakers with normal hearing and no neurological or psychiatric history. The experimental procedures were reviewed and approved by the Ethical Review Board of the Southern University of Science and Technology (Approval No. 2022DZX003). Each participant provided written informed consent and explicitly agreed to the public sharing of their anonymized data. All personally identifiable information was removed to ensure complete data privacy.\\n\\nExperimental Design and Procedure\\n\\nEach participant completed 60 trials (60 s each) organized into six randomized attention-switching blocks of 10. Two narrative speech streams, one male and one female, were simultaneously presented through headphones at \\u00b190\\u00b0 azimuth using head-related transfer functions (HRTFs) to simulate spatial separation.\\n\\n\\n\\nIn half the trials, male speech was presented to the left ear and female to the right; in the remaining half, the configuration was reversed.\\n\\nParticipants freely chose which stream to attend to and could spontaneously switch attention between them, pressing a button to mark each switch.\\n\\nEach session lasted approximately 150 minutes, including setup, training, and rest breaks between blocks.\\n\\n\\nIn addition to the main attention-switching blocks, a passive listening control condition was conducted as the final block (10 trials). \\u00a0During this block, participants did not perform voluntary auditory attention switching but were instructed to press the response keys alternately at a rate that roughly matched the switching frequency observed during their previous blocks.\\n\\nThe system synchronized all EEG, audio, and behavioral markers to achieve precise temporal alignment of attention labels.\\n\\nDataset and Code Release:\\n\\nThis public release provides the complete Auditory Attention Switching Dataset (AASD) for research use. The dataset includes EEG recordings, synchronized auditory stimuli, and behavioral markers collected from all eighteen participants. Each participant completed sixty trials of sixty seconds, involving self-initiated attention switches between two spatialized speech streams.\\n\\nThis release contains:\\n\\n\\n\\nEEG recordings from sixty-four channels under spatialized dual-speaker listening conditions.\\n\\nRaw EEG data in CNT format and preprocessed EEG data in MAT format, aligned with corresponding event triggers.\\n\\nSpatialized two-channel speech stimuli generated from the AISHELL Mandarin corpus (three male and three female speakers).\\n\\nTrial-level metadata including attention direction and button-press timestamps marking spontaneous switch events.\", \"is_draft\": false, \"languages\": [{\"id\": \"cmn\", \"title_l10n\": \"Mandarin Chinese\"}], \"publication_date_l10n_long\": \"October 22, 2025\", \"publication_date_l10n_medium\": \"Oct 22, 2025\", \"resource_type\": {\"id\": \"dataset\", \"title_l10n\": \"Dataset\"}, \"rights\": [{\"description_l10n\": \"The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited.\", \"icon\": \"cc-by-icon\", \"id\": \"cc-by-4.0\", \"props\": {\"scheme\": \"spdx\", \"url\": \"https://creativecommons.org/licenses/by/4.0/legalcode\"}, \"title_l10n\": \"Creative Commons Attribution 4.0 International\"}], \"updated_date_l10n_long\": \"February 25, 2026\", \"version\": \"v1\"}, \"updated\": \"2026-02-25T08:31:09.537956+00:00\", \"versions\": {\"index\": 1, \"is_latest\": true}}' data-preview='false'>\n  <h2 class=\"ui small top attached header\">External resources</h2>", "is_error": false}]}, "parent_tool_use_id": null, "session_id": "3229f8ec-9185-4188-97bc-2433c848e566", "uuid": "feaebdb4-cc57-40f1-a9d1-5136d7b98d0a", "timestamp": "2026-08-04T14:12:00.274Z", "tool_use_result": {"stdout": "EXIT=0\n\n\n\n<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n  <head>\n  \n    \n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"google-site-verification\" content=\"5fPGCLllnWrvFxH9QWI0l1TadV7byeEvfPcyK2VkS_s\"/>\n    <meta name=\"google-site-verification\" content=\"Rp5zp04IKW-s1IbpTOGB7Z6XY60oloZD5C3kTM-AiY4\"/>\n\n    \n    \n    <meta name=\"generator\" content=\"InvenioRDM 15.0\"/>\n\n    \n    \n    \n \n    <meta name=\"citation_title\" content=\"AASD: An Open Non-Invasive EEG Dataset for Spontaneous Auditory Attention Switch Decoding\" />\n    <meta name=\"citation_abstract_html_url\" content=\"https://zenodo.org/records/17413336\" />\n    <meta property=\"og:title\" content=\"AASD: An Open Non-Invasive EEG Dataset for Spontaneous Auditory Attention Switch Decoding\" />\n    <meta name=\"twitter:title\" content=\"AASD: An Open Non-Invasive EEG Dataset for Spontaneous Auditory Attention Switch Decoding\" />\n      <title>AASD: An Open Non-Invasive EEG Dataset for Spontaneous Auditory Attention Switch Decoding | Zenodo</title>\n                      <span class=\"ui\" title=\"Publication date\">\n              <div class=\"ui divider hidden\"></div><section id=\"record-title-section\"\n                       aria-label=\"Record title, authors and contributors\">\n                <h1 id=\"record-title\"\n    <h2 id=\"description-heading\" class=\"sr-only\">Description</h2>\n    ><h2 id=\"files-heading\">Files</h2>\n    <h3 class=\"active title pane