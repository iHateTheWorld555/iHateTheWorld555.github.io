336\", \"draft\": \"https://zenodo.org/api/records/17413336/draft\", \"file_modification\": \"https://zenodo.org/api/records/17413336/file-modification\", \"files\": \"https://zenodo.org/api/records/17413336/files\", \"latest\": \"https://zenodo.org/api/records/17413336/versions/latest\", \"latest_html\": \"https://zenodo.org/records/17413336/latest\", \"media_files\": \"https://zenodo.org/api/records/17413336/media-files\", \"parent\": \"https://zenodo.org/api/records/17413335\", \"parent_doi\": \"https://doi.org/10.5281/zenodo.17413335\", \"parent_doi_html\": \"https://zenodo.org/doi/10.5281/zenodo.17413335\", \"parent_html\": \"https://zenodo.org/records/17413335\", \"preview_html\": \"https://zenodo.org/records/17413336?preview=1\", \"quota_increase\": \"https://zenodo.org/api/records/17413336/quota-increase\", \"request_deletion\": \"https://zenodo.org/api/records/17413336/request-deletion\", \"requests\": \"https://zenodo.org/api/records/17413336/requests\", \"reserve_doi\": \"https://zenodo.org/api/records/17413336/draft/pids/doi\", \"self\": \"https://zenodo.org/api/records/17413336\", \"self_doi\": \"https://doi.org/10.5281/zenodo.17413336\", \"self_doi_html\": \"https://zenodo.org/doi/10.5281/zenodo.17413336\", \"self_html\": \"https://zenodo.org/records/17413336\", \"self_iiif_manifest\": \"https://zenodo.org/api/iiif/record:17413336/manifest\", \"self_iiif_sequence\": \"https://zenodo.org/api/iiif/record:17413336/sequence/default\", \"versions\": \"https://zenodo.org/api/records/17413336/versions\"}, \"media_files\": {\"count\": 0, \"enabled\": false, \"entries\": {}, \"order\": [], \"total_bytes\": 0}, \"metadata\": {\"creators\": [{\"person_or_org\": {\"family_name\": \"Wang\", \"given_name\": \"Xuefei\", \"name\": \"Wang, Xuefei\", \"type\": \"personal\"}}, {\"person_or_org\": {\"family_name\": \"Ding\", \"given_name\": \"Yuting\", \"name\": \"Ding, Yuting\", \"type\": \"personal\"}}, {\"person_or_org\": {\"family_name\": \"Ban\", \"given_name\": \"Yu