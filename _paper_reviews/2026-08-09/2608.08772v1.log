{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "chatcmpl-tool-96cf7852a6359791", "type": "tool_result", "content": "{\n  \"arxiv_id\": \"2601.03888\",\n  \"title\": \"IndexTTS 2.5 Technical Report\",\n  \"authors\": [\n    \"Yunpei Li\",\n    \"Xun Zhou\",\n    \"Jinchao Wang\",\n    \"Lu Wang\",\n    \"Yong Wu\",\n    \"Siyi Zhou\",\n    \"Yiquan Zhou\",\n    \"Jingchen Shu\"\n  ],\n  \"year\": 2026,\n  \"venue\": \"\",\n  \"categories\": [\n    \"cs.SD\",\n    \"cs.AI\"\n  ],\n  \"topic\": \"tts_vc\",\n  \"tags\": [\n    \"TTS\",\n    \"TTS/\\u67b6\\u6784-AR-LLM\",\n    \"TTS/\\u529f\\u80fd-\\u591a\\u8bed\\u8a00\",\n    \"TTS/\\u529f\\u80fd-RL\\u4f18\\u5316\"\n  ],\n  \"contributions\": [\n    \"Semantic codec frame rate is reduced from 50 Hz to 25 Hz to halve sequence length and lower training and inference costs.\",\n    \"The U-DiT backbone in the Semantic-to-Mel module is replaced with a more efficient Zipformer architecture to reduce parameters and accelerate mel-spectrogram generation.\",\n    \"Three explicit cross-lingual modeling strategies are proposed to enable robust zero-shot multilingual emotional TTS and cross-lingual emotion transfer across Chinese, English, Japanese, and Spanish.\",\n    \"Group Relative Policy Optimization is applied to post-train the Text-to-Semantic module, improving pronunciation accuracy and prosodic naturalness.\"\n  ],\n  \"citations\": [\n    {\n      \"paper_id\": \"\",\n      \"title\": \"Demucs\",\n      \"cite_type\": \"supported_by\",\n      \"context\": \"Used as the source separation tool to extract vocal tracks from audio segments containing accompaniment.\",\n      \"bib_key\": \"\",\n      \"source\": \"llm\"\n    },\n    {\n      \"paper_id\": \"\",\n      \"title\": \"Emilia\",\n      \"cite_type\": \"supported_by\",\n      \"context\": \"Used as a source of multilingual speech training data for Chinese, English, and Japanese.\",\n      \"bib_key\": \"\",\n      \"source\": \"llm\"\n  