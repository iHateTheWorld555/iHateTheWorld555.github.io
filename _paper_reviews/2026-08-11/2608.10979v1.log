{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-85cefbfb9b3d9353","type":"tool_result","content":"1\t<!DOCTYPE html>\n2\t<html lang=\"en\">\n3\t\n4\t<head><script>document.documentElement.classList.add('js');</script>  <title>[2608.10979v1] Pitch Contour Tokenization using VQ-VAE and Its Application on Korean Traditional Music Analysis</title>\n5\t  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n6\t  <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/static/browse/0.3.4/images/icons/apple-touch-icon.png\">\n7\t  <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/static/browse/0.3.4/images/icons/favicon-32x32.png\">\n8\t  <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/static/browse/0.3.4/images/icons/favicon-16x16.png\">\n9\t  <link rel=\"manifest\" href=\"/static/browse/0.3.4/images/icons/site.webmanifest\">\n10\t  <link rel=\"mask-icon\" href=\"/static/browse/0.3.4/images/icons/safari-pinned-tab.svg\" color=\"#5bbad5\">\n11\t  <meta name=\"msapplication-TileColor\" content=\"#da532c\">\n12\t  <meta name=\"theme-color\" content=\"#ffffff\">\n13\t  <link rel=\"stylesheet\" type=\"text/css\" media=\"screen\" href=\"/static/browse/0.3.4/css/arXiv.css?v=20260318\" />\n14\t  <link rel=\"stylesheet\" type=\"text/css\" media=\"print\" href=\"/static/browse/0.3.4/css/arXiv-print.css?v=20200611\" />\n15\t  <link rel=\"stylesheet\" type=\"text/css\" media=\"screen\" href=\"/static/browse/0.3.4/css/browse_search.css\" />\n16\t  <link rel=\"stylesheet\" type=\"text/css\" media=\"screen\" href=\"/static/base/1.0.1/css/arxiv-header-footer.css?v=20260626\" />\n17\t  <script language=\"javascript\" src=\"/static/browse/0.3.4/js/accordion.js\" ></script>\n18\t  <script language=\"javascript\" src=\"/static/browse/0.3.4/js/optin-modal.js?v=20250819\"></script>\n19\t  \n20\t  <link rel=\"canonical\" href=\"https://arxiv.org/abs/2608.10979\"/>\n21\t  <meta name=\"description\" content=\"Abstract page for arXiv paper 2608.10979v1: Pitch Contour Tokenization using VQ-VAE and Its Application on Korean Traditional Music Analysis\"><meta property=\"og:type\" content=\"website\" />\n22\t<meta property=\"og:site_name\" content=\"arXiv.org\" />\n23\t<meta property=\"og:title\" content=\"Pitch Contour Tokenization using VQ-VAE and Its Application on Korean Traditional Music Analysis\" />\n24\t<meta property=\"og:url\" content=\"https://arxiv.org/abs/2608.10979v1\" />\n25\t<meta property=\"og:image\" content=\"/static/browse/0.3.4/images/arxiv-logo-fb.png\" />\n26\t<meta property=\"og:image:secure_url\" content=\"/static/browse/0.3.4/images/arxiv-logo-fb.png\" />\n27\t<meta property=\"og:image:width\" content=\"1200\" />\n28\t<meta property=\"og:image:height\" content=\"700\" />\n29\t<meta property=\"og:image:alt\" content=\"arXiv logo\"/>\n30\t<meta property=\"og:description\" content=\"Computational analysis of music often relies on discrete representations, yet many musical traditions are organized around continuous pitch movement that resists segmentation into note-like units. For such traditions, the discrete units that analysis would build on are not given in advance. We address this gap by learning a vocabulary of local pitch-contour patterns directly from unlabeled audio, using a VQ-VAE that quantizes fixed-length contour segments into a finite codebook. To make the learned tokens stable across segmentation positions and small variations in timing and pitch range, we train the model with a reconstruction objective evaluated under the best alignment among a set of candidate temporal and pitch-domain transformations. Applied to Korean traditional music, the learned tokens recover information about expert-defined sigimsae categories without supervision, and in pansori individual tokens align with the two principal modes, Gyemyeonjo and Ujo, supporting their use as units for corpus-level analysis of contour-centric traditions.\"/>\n31\t<meta name=\"twitter:site\" content=\"@arxiv\"/>\n32\t<meta name=\"twitter:card\" content=\"summary\"/>\n33\t<meta name=\"twitter:title\" content=\"Pitch Contour Tokenization using VQ-VAE and Its Application on...\"/>\n34\t<meta name=\"twitter:description\" content=\"Computational analysis of music often relies on discrete representations, yet many musical traditions are organized around continuous pitch movement that resists segmentation into note-like units....\"/>\n35\t<meta name=\"twitter:image\" content=\"https://static.arxiv.org/icons/twitter/arxiv-logo-twitter-square.png\"/>\n36\t<meta name=\"twitter:image:alt\" content=\"arXiv logo\"/>\n37\t  <link rel=\"stylesheet\" media=\"screen\" type=\"text/css\" href=\"/static/browse/0.3.4/css/tooltip.css\"/><link rel=\"stylesheet\" media=\"screen\" type=\"text/css\" href=\"https://static.arxiv.org/js/bibex-dev/bibex.css?20200709\"/>  <script src=\"/static/browse/0.3.4/js/mathjaxToggle.min.js\" type=\"text/javascript\"></script>  <script src=\"//code.jquery.com/jquery-latest.min.js\" type=\"text/javascript\"></script>\n38\t  <script src=\"//cdn.jsdelivr.net/npm/js-cookie@2/src/js.cookie.min.js\" type=\"text/javascript\"></script>\n39\t  <script src=\"//cdn.jsdelivr.net/npm/dompurify@2.3.5/dist/purify.min.js\"></script>\n40\t  <script src=\"/static/browse/0.3.4/js/toggle-labs.js?20241022\" type=\"text/javascript\"></script>\n41\t  <script src=\"/static/browse/0.3.4/js/cite.js\" type=\"text/javascript\"></script><meta name=\"citation_title\" content=\"Pitch Contour Tokenization using VQ-VAE and Its Application on Korean Traditional Music Analysis\" /><meta name=\"citation_author\" content=\"Ju, Seonguk\" /><meta name=\"citation_author\" content=\"Cho, Seola\" /><meta name=\"citation_author\" content=\"Chung, Sooin\" /><meta name=\"citation_author\" content=\"Han, Danbinaerin\" /><meta name=\"citation_author\" content=\"Jeong, Dasaem\" /><meta name=\"citation_date\" content=\"2026/08/11\" /><meta name=\"citation_online_date\" content=\"2026/08/11\" /><meta name=\"citation_pdf_url\" content=\"https://arxiv.org/pdf/2608.10979\" /><meta name=\"citation_arxiv_id\" content=\"2608.10979\" /><meta name=\"citation_abstract\" content=\"Computational analysis of music often relies on discrete representations, yet many musical traditions are organized around continuous pitch movement that resists segmentation into note-like units. For such traditions, the discrete units that analysis would build on are not given in advance. We address this gap by learning a vocabulary of local pitch-contour patterns directly from unlabeled audio, using a VQ-VAE that quantizes fixed-length contour segments into a finite codebook. To make the learned tokens stable across segmentation positions and small variations in timing and pitch range, we train the model with a reconstruction objective evaluated under the best alignment among a set of candidate temporal and pitch-domain transformations. Applied to Korean traditional music, the learned tokens recover information about expert-defined sigimsae categories without supervision, and in pansori individual tokens align with the two principal modes, Gyemyeonjo and Ujo, supporting their use as units for corpus-level analysis of contour-centric traditions.\" />\n42\t</head>\n43\t\n44\t<body ><div class=\"flex-wrap-footer\">\n45\t    <a href=\"#content\" class=\"ds-skip-link\">Skip to main content</a>\n46\t  \n47\t  \n48\t  \n49\t<header class=\"ds-site-header\">\n50\t  <a aria-hidden=\"true\" tabindex=\"-1\" href=\"https://arxiv.org/IgnoreMe\" class=\"is-sr-only\"></a>\n51\t\n52\t  <a href=\"https://arxiv.org/\" class=\"ds-site-header-logo\" aria-label=\"archive home\">\n53\t    <img src=\"/static/base/1.0.1/images/arxiv-logo-primary-light.svg\" alt=\"archive\">\n54\t  </a>\n55\t\n56\t  <button type=\"button\" id=\"ds-nav-toggle\" class=\"ds-site-header-nav-toggle\"\n57\t    aria-label=\"Open menu\" aria-controls=\"ds-site-header-nav\" aria-expanded=\"false\">\n58\t    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n59\t      <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"/>\n60\t      <line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"/>\n61\t      <line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"/>\n62\t    </svg>\n63\t  </button>\n64\t\n65\t  <nav class=\"ds-site-header-nav\" id=\"ds-site-header-nav\" aria-label=\"Main navigation\"><a id=\"arxiv-search-toggle\" href=\"https://arxiv.org/search\"\n66\t      aria-controls=\"arxiv-search-overlay\" aria-expanded=\"false\">\n67\t      <svg class=\"ds-nav-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n68\t        <circle cx=\"11\" cy=\"11\" r=\"8\"/>\n69\t        <line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/>\n70\t      </svg>\n71\t      Search\n72\t    </a>\n73\t    <a href=\"https://arxiv.org/user/create\">Submit</a>\n74\t    <a href=\"https://info.arxiv.org/about/donate.html\">Donate</a>\n75\t    <span class=\"ds-site-header-divider\" aria-hidden=\"true\"></span>\n76\t      <a href=\"https://arxiv.org/login\" class=\"ds-site-header-login\">Log in</a>\n77\t  </nav>\n78\t</header>\n79\t\n80\t<div class=\"arxiv-search-overlay\" id=\"arxiv-search-overlay\" hidden>\n81\t  <div class=\"arxiv-search-panel\" role=\"search\">\n82\t    <form method=\"GET\" action=\"https://arxiv.org/search\">\n83\t      <label for=\"arxiv-search-input\" class=\"is-sr-only\">Search arXiv</label>\n84\t      <input type=\"text\" name=\"query\" id=\"arxiv-search-input\" autocomplete=\"off\"\n85\t        placeholder=\"Search papers by title, author, abstract, or ID...\">\n86\t      <input type=\"hidden\" name=\"searchtype\" value=\"all\">\n87\t      <input type=\"hidden\" name=\"source\" value=\"header\">\n88\t    </form>\n89\t    <div class=\"arxiv-search-hint\">\n90\t      Press Enter to search &middot; <a href=\"https://arxiv.org/search/advanced\">Advanced search</a>\n91\t    </div>\n92\t  </div>\n93\t</div>\n94\t    <main>\n95\t      <div id=\"content\">\n96\t<!--\n97\trdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"\n98\t         xmlns:dc=\"http://purl.org/dc/elements/1.1/\"\n99\t         xmlns:trackback=\"http://madskills.com/public/xml/rss/module/trackback/\">\n100\t    <rdf:Description\n101\t        rdf:about=\"/abs/2608.10979\"\n102\t        dc:identifier=\"/abs/2608.10979\"\n103\t        dc:title=\"Pitch Contour Tokenization using VQ-VAE and Its Application on Korean Traditional Music Analysis\"\n104\t        trackback:ping=\"/trackback/2608.10979\" />\n105\t    </rdf:RDF>\n106\t--><div id=\"abs-outer\">\n107\t\n108\t  <div class=\"leftcolumn\">\n109\t    <div class=\"subheader\">\n110\t      <h1>Computer Science > Sound</h1>\n111\t    </div>\n112\t\n113\t    <div class=\"header-breadcrumbs-mobile\">\n114\t      <strong>arXiv:2608.10979v1</strong> (cs)\n115\t    </div>\n116\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/static/base/1.0.1/css/abs.css\">\n117\t<div id=\"content-inner\">\n118\t  <div id=\"abs\">\n119\t    <div class=\"dateline\">\n120\t  [Submitted on 11 Aug 2026]</div>\n121\t    <h1 class=\"title mathjax\"><span class=\"descriptor\">Title:</span>Pitch Contour Tokenization using VQ-VAE and Its Application on Korean Traditional Music Analysis</h1>\n122\t    <div class=\"authors\"><span class=\"descriptor\">Authors:</span><a href=\"https://arxiv.org/search/cs?searchtype=author&amp;query=Ju,+S\" rel=\"nofollow\">Seonguk Ju</a>, <a href=\"https://arxiv.org/search/cs?searchtype=author&amp;query=Cho,+S\" rel=\"nofollow\">Seola Cho</a>, <a href=\"https://arxiv.org/search/cs?searchtype=author&amp;query=Chung,+S\" rel=\"nofollow\">Sooin Chung</a>, <a href=\"https://arxiv.org/search/cs?searchtype=author&amp;query=Han,+D\" rel=\"nofollow\">Danbinaerin Han</a>, <a href=\"https://arxiv.org/search/cs?searchtype=author&amp;query=Jeong,+D\" rel=\"nofollow\">Dasaem Jeong</a></div>            <div id=\"download-button-info\" hidden>View a PDF of the paper titled Pitch Contour Tokenization using VQ-VAE and Its Application on Korean Traditional Music Analysis, by Seonguk Ju and 4 other authors</div>\n123\t    <a class=\"mobile-submission-download\" href=\"/pdf/2608.10979v1\">View PDF</a>\n124\t    <a class=\"mobile-submission-download\" href=\"https://arxiv.org/html/2608.10979v1\">HTML (experimental)</a>\n125\t\n126\t\n127\t\n128\t    <blockquote class=\"abstract mathjax\">\n129\t            <span class=\"descriptor\">Abstract:</span>Computational analysis of music often relies on discrete representations, yet many musical traditions are organized around continuous pitch movement that resists segmentation into note-like units. For such traditions, the discrete units that analysis would build on are not given in advance. We address this gap by learning a vocabulary of local pitch-contour patterns directly from unlabeled audio, using a VQ-VAE that quantizes fixed-length contour segments into a finite codebook. To make the learned tokens stable across segmentation positions and small variations in timing and pitch range, we train the model with a reconstruction objective evaluated under the best alignment among a set of candidate temporal and pitch-domain transformations. Applied to Korean traditional music, the learned tokens recover information about expert-defined sigimsae categories without supervision, and in pansori individual tokens align with the two principal modes, Gyemyeonjo and Ujo, supporting their use as units for corpus-level analysis of contour-centric traditions.\n130\t    </blockquote>\n131\t\n132\t    <!--CONTEXT-->\n133\t    <div class=\"metatable\">\n134\t      <table summary=\"Additional metadata\">        <tr>\n135\t          <td class=\"tablecell label\">Comments:</td>\n136\t          <td class=\"tablecell comments mathjax\">8 pages, 3 figures, 2 tables. Accepted at ISMIR 2026</td>\n137\t        </tr>\n138\t<tr>\n139\t          <td class=\"tablecell label\">Subjects:</td>\n140\t          <td class=\"tablecell subjects\">\n141\t            <span class=\"primary-subject\">Sound (cs.SD)</span></td>\n142\t        </tr><tr>\n143\t          <td class=\"tablecell label\">Cite as:</td>\n144\t          <td class=\"tablecell arxivid\"><span class=\"arxivid\"><a href=\"https://arxiv.org/abs/2608.10979\">arXiv:2608.10979</a> [cs.SD]</span></td>\n145\t        </tr>\n146\t        <tr>\n147\t          <td class=\"tablecell label\">&nbsp;</td>\n148\t          <td class=\"tablecell arxividv\">(or <span class=\"arxivid\">\n149\t              <a href=\"https://arxiv.org/abs/2608.10979v1\">arXiv:2608.10979v1</a> [cs.SD]</span> for this version)\n150\t          </td>\n151\t        </tr>\n152\t        <tr>\n153\t          <td class=\"tablecell label\">&nbsp;</td>\n154\t          <td class=\"tablecell arxivdoi\">              <a href=\"https://doi.org/10.48550/arXiv.2608.10979\"  id=\"arxiv-doi-link\">https://doi.org/10.48550/arXiv.2608.10979</a><div class=\"button-and-tooltip\">\n155\t              <button class=\"more-info\" aria-describedby=\"more-info-desc-1\">\n156\t                <svg height=\"15\" role=\"presentation\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"><path fill=\"currentColor\" d=\"M256 8C119.043 8 8 119.083 8 256c0 136.997 111.043 248 248 248s248-111.003 248-248C504 119.083 392.957 8 256 8zm0 110c23.196 0 42 18.804 42 42s-18.804 42-42 42-42-18.804-42-42 18.804-42 42-42zm56 254c0 6.627-5.373 12-12 12h-88c-6.627 0-12-5.373-12-12v-24c0-6.627 5.373-12 12-12h12v-64h-12c-6.627 0-12-5.373-12-12v-24c0-6.627 5.373-12 12-12h64c6.627 0 12 5.373 12 12v100h12c6.627 0 12 5.373 12 12v24z\" class=\"\"></path></svg>\n157\t                <span class=\"visually-hidden\">Focus to learn more</span>\n158\t              </button>\n159\t              <!-- tooltip description -->\n160\t              <div role=\"tooltip\" id=\"more-inf